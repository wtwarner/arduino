    385  f873							;  multiplexer and also set the bit which enables the compartor
    386  f873		       20 f0		      BRA	SET_MUX	; Use the section of code above to write this value out
    387  f875							;  to the multiplexer channel select latch and also to prepare
    388  f875							;  the output compare pin for a positive transition on the next
    389  f875							;  interrupt
    390  f875							; A/D conversion state 2
    391  f875		       f8 75	   STATE_2    EQU	*	; This routine is not required to perform any A/D
    392  f875							;  related functions, but it does perform every periodic
    393  f875							;  function whose period is longer than 1/20 second as well as
    394  f875							;  maintaining synchronization with the line
    395  f875
    396  f875							;; Line synchronization function
    397  f875
    398  f875							; There are two basic purposes to this section: first, it maintains
    399  f875							; correct synchronization with the ac line at all times. To do
    400  f875							; this, it checks once during each conversion to see whether then
    401  f875							; internal timing has shifted by more than plus or minus 60 degrees
    402  f875							; with respect to the ac line. If it has then the internal timing
    403  f875							; is shifted slightly, making that measurement cycle slightly longer
    404  f875							; or slightly shorter than nominal to try to bring the timing back
    405  f875							; within the plus or minus 60 degree phase window. If there has been
    406  f875							; a large phase shift then it might take several shortened or
    407  f875							; lengthened cycles to get back to within the window.	As soon as they
    408  f875							; are back in phase, normal length cycles are resumed. The second
    409  f875							; function is more subtle. It is also activated by phase shifts of
    410  f875							; more than 60 degrees, but in this case the effect is to make very
    411  f875							; small but permanent changes in the normal lengt of a cycle.	This
    412  f875							; type of change would not be necessary if the ac line signal were
    413  f875							; always going to be present to maintian synchronization, but since
    414  f875							; the instrument can have a battery backup, and since better accuracy
    415  f875							; than just the nominal crystal frequency accuracy is desirable, the
    416  f875							; software is, in effect, gradually forming a correction to the
    417  f875							; crystal frequency, based on line frequency, which will then be
    418  f875							; used while the ac power is off.
    419  f875
    420  f875		       96 83		      LDAA	TIME_CORRECT+1	; Since the period of a conversion is 50,000
    421  f877							;  instruction cycles, if the correction were an integer value in
    422  f877							;  cycles, the best correction that could be made is plus or minus
    423  f877							;  1/50,000 which is nearly two seconds per day of error - to get
    424  f877							;  around this, a one byte fractional correction is maintained.
    425  f877		       9b 8f		      ADDA	TIME_RESIDUAL	; To use this correction, it is added each time to
    426  f879							;  a one byte residual value, and each time there is a carry
    427  f879							;  from this byte, one more full instruction cycle is added
    428  f879							;  to this time
    429  f879		       97 8f		      STAA	TIME_RESIDUAL	; Save the new residual
    430  f87b		       dc 0b		      LDD	TIMER_OCR_REG	; Take the previously calculated time of the next
    431  f87d							;  interrupt
    432  f87d							;; PAGE 11
    433  f87d		       d9 82		      ADCB	TIME_CORRECT	; Add in the upper byte of the correction value
    434  f87f		       89 00		      ADCA	#0	; Handle any carry to the top byte of the interrupt time
    435  f881		       7d 00 82 	      TST	TIME_CORRECT	; See whether the correction was intended to be
    436  f884							;  positive or negative
    437  f884		       2a 01		      BPL	IS_POS	; If it is negative then
    438  f886		       4a		      DECA		; subtract one count from the top byte
    439  f887		       dd 0b	   IS_POS     STD	TIMER_OCR_REG	; Put back the corrected time of the next interrupt
    440  f889		       de 82		      LDX	TIME_CORRECT	; Get the correction value in case it whill need to
    441  f88b							;  be adjusted
    442  f88b		       96 81		      LDAA	LINE_PHASE	; See what the AC line has been doing for the last
    443  f88d							;  eight interrupts
    444  f88d		       81 1c		      CMPA	#%00011100	; Test for internal time fast by 60 degrees or more
    445  f88f		       26 04		      BNE	IS_NOT_FAST	; If it is then
    446  f891		       7a 00 0b 	      DEC	TIMER_OCR_REG	;  shorten this conversion
    447  f894		       09		      DEX		;  and slightly shorten all subsequenty conversions
    448  f895		       81 e3	   IS_NOT_FAST CMPA	#%11100011	; Else test for internal time slow
    449  f897		       26 04		      BNE	IS_NOT_SLOW	; If it is then
    450  f899		       7c 00 0b 	      INC	TIMER_OCR_REG	;  lengthen this conversion
    451  f89c		       08		      INX		;  and slightly length all subsequent conversions
    452  f89d		       df 82	   IS_NOT_SLOW STX	TIME_CORRECT	; Put back the (possibly) modified correction
    453  f89f
    454  f89f							;; PAGE 12
    455  f89f
    456  f89f							; The final operation to be performed at 20 Hz is decrementing a
    457  f89f							; counter which is used to time 6 second intervals, because the
    458  f89f							; next groups of functions is performed ten times each minute
    459  f89f		       7a 00 92 	      DEC	TWENTIETHS	; This variable counts twentieths of a second
    460  f8a2		       26 59		      BNE	IRET	; If six seconds have not elapsed yet then just return
    461  f8a4		       86 78		      LDAA	#120	; Else restart the counter at six seconds
    462  f8a6		       97 92		      STAA	TWENTIETHS
    463  f8a8		       96 95		      LDAA	TENTHS	; The next counter is used to count tenths of a minute.
    464  f8aa		       8b 01		      ADDA	#1	;  In BCD, up to 99 tenths
    465  f8ac		       19		      DAA		; Since this is a BCD counter, adjust it to a decimal value each
    466  f8ad		       97 95		      STAA	TENTHS	;  time it is incremented
    467  f8af		       27 4d		      BEQ	TEN_MINUTES	; If ten minutes has elapsed then perform those
    468  f8b1							;  functions which are done every ten minutes.
    469  f8b1
    470  f8b1							;; PAGE 13
    471  f8b1
    472  f8b1							; The next function is performed 99 times every ten minutes.  It is
    473  f8b1							; not done the hundredth time because there is a lot more to be
    474  f8b1							; done that time and it would make the processor loading much higher
    475  f8b1							; to do both. the function of this section of code is to update the
    476  f8b1							; minimum and maximum values of each of the three zone temperatures.
    477  f8b1							; The mean values are updated at ten minute intervals.
    478  f8b1		       96 98		      LDAA	TIME_OF_DAY	; Load the current time into register A in case we
    479  f8b3							;  need to note the time at which a new min or max was reached
    480  f8b3		       de 8d		      LDX	CONV_BUF	; Load the current temperature of zone 1
    481  f8b5		       9c a8		      CPX	TODAY_MAX1	; see if it is a new daily maximum
    482  f8b7		       24 04		      BHS	IS_HIGHER1	; Since the conversion value varies inversely with the
    483  f8b9							;  temperature, the sense of the test looks backward
    484  f8b9		       df a8		      STX	TODAY_MAX1	; If the current temp ois higher than the previous
    485  f8bb							;  daily maximum then replace the old maximum with the current
    486  f8bb		       97 aa		      STAA	TODAY_MAX1+2	; The third byte of this value is the time of day
    487  f8bd							;  at which the maximum occured, in tens of minutes.
    488  f8bd		       9c 9f	   IS_HIGHER1 CPX	TODAY_MIN1	; If no new maximum then see if new minimum
    489  f8bf		       23 04		      BLS	IS_LOWER1	; Again, skip the next 2 instructions if no new min
    490  f8c1		       df 9f		      STX	TODAY_MIN1
    491  f8c3		       97 a1		      STAA	TODAY_MIN1+2
    492  f8c5		       de 90	   IS_LOWER1  LDX	CONV_BUF+3	; Do the same for zone 2
    493  f8c7		       9c ab		      CPX	TODAY_MAX2
    494  f8c9		       24 04		      BHS	IS_HIGHER2
    495  f8cb		       df ab		      STX	TODAY_MAX2
    496  f8cd		       97 ad		      STAA	TODAY_MAX2+2
    497  f8cf		       9c a2	   IS_HIGHER2 CPX	TODAY_MIN2
    498  f8d1		       23 04		      BLS	IS_LOWER2
    499  f8d3		       df a2		      STX	TODAY_MIN2
    500  f8d5		       97 a4		      STAA	TODAY_MIN2+2
    501  f8d7		       de 93	   IS_LOWER2  LDX	CONV_BUF+6	; And for zone 3
    502  f8d9		       9c ae		      CPX	TODAY_MAX3
    503  f8db		       24 04		      BHS	IS_HIGHER3
    504  f8dd		       df ae		      STX	TODAY_MAX3
    505  f8df		       97 b0		      STAA	TODAY_MAX3+2
    506  f8e1		       9c a5	   IS_HIGHER3 CPX	TODAY_MIN3
    507  f8e3		       23 04		      BLS	IS_LOWER3
    508  f8e5		       df a5		      STX	TODAY_MIN3
    509  f8e7		       97 a7		      STAA	TODAY_MIN3+2
    510  f8e9		       7f 00 d8    IS_LOWER3  CLR	ALARM	; Calculate the new alarm bits, first clearing out the old
    511  f8ec		       dc 99		      LDD	CONV_BUF+12	; See if zone 3 is higher than the high reference
    512  f8ee		       93 93		      SUBD	CONV_BUF+6
    513  f8f0		       79 00 d8 	      ROL	ALARM	; If it is then set the low temp alarm bit (high to turn on)
    514  f8f3		       dc 93		      LDD	CONV_BUF+6	; See if zone 3 is lower than the average of the high
    515  f8f5		       05		      LSLD		;  and low references
    516  f8f6		       93 96		      SUBD	CONV_BUF+9
    517  f8f8		       93 99		      SUBD	CONV_BUF+12
    518  f8fa		       79 00 d8 	      ROL	ALARM	; If it is then set the high temp alarm (high to turn on)
    519  f8fd		       3b	   IRET       RTI		; This completes the operations performed ten times each
    520  f8fe							;  minute
    521  f8fe							;; PAGE 14
    522  f8fe							;; Functions performed every ten minutes
    523  f8fe
    524  f8fe							; Every ten minutes the calculated value of today's mean temperature
    525  f8fe							; for each of the three zones is updated. After that, a check is made
    526  f8fe							; for two special times of the day, midnight and 2AM.
    527  f8fe
    528  f8fe		       f8 fe	   TEN_MINUTES EQU	*
    529  f8fe		       dc cd		      LDD	TODAY_MEAN1+1	; Get the second and third bytes of the running
    530  f900							;  sum of zone 1 at ten minute intervals so far today
    531  f900		       d3 8d		      ADDD	CONV_BUF	; Add in the latest value for this zone
    532  f902		       dd cd		      STD	TODAY_MEAN1+1	; Return the updated second and third bytes
    533  f904		       24 03		      BCC	NO_CARRY1	; If there was a carry generated by this addition then
    534  f906		       7c 00 cc 	      INC	TODAY_MEAN1	;  increment the first byte
    535  f909
    536  f909		       dc d0	   NO_CARRY1  LDD	TODAY_MEAN2+1	; Repeat the process for zone 2
    537  f90b		       d3 90		      ADDD	CONV_BUF+3
    538  f90d		       dd d0		      STD	TODAY_MEAN2+1
    539  f90f		       24 03		      BCC	NO_CARRY2
    540  f911		       7c 00 cf 	      INC	TODAY_MEAN2
    541  f914
    542  f914		       dc d3	   NO_CARRY2  LDD	TODAY_MEAN3+1	; And for zone 3
    543  f916		       d3 93		      ADDD	CONV_BUF+6
    544  f918		       dd d3		      STD	TODAY_MEAN3+1
    545  f91a		       24 03		      BCC	NO_CARRY3
    546  f91c		       7c 00 d2 	      INC	TODAY_MEAN3
    547  f91f
    548  f91f		       7c 00 9e    NO_CARRY3  INC	MEAN_COUNT	; Increment the counter to show that one more value has
    549  f922							;  been summed in
    550  f922		       96 98		      LDAA	TIME_OF_DAY	; Now increment the time-of-day counter by ten minutes
    551  f924		       4c		      INCA
    552  f925		       81 90		      CMPA	#6*24	; See if it is midnight
    553  f927		       24 67		      BHS	MIDNIGHT	; If it is then take care of any daily chores
    554  f929		       97 98		      STAA	TIME_OF_DAY	; Otherwise save the incremented time
    555  f92b		       81 0c		      CMPA	#6*2	; Now see if it is 2AM
    556  f92d		       26 ce		      BNE	IRET	; If not then we are done for now
    557  f92f		       96 02		      LDAA	PORT1	; If it is 2AM then there is a possibility that we need to
    558  f931		       85 20		      BITA	#DST_JUMPER	;  adjust for daylight saving time
    559  f933		       26 c8		      BNE	IRET	; If the jumper has been removed then daylight saving time is
    560  f935							;  disabled.
    561  f935		       96 c8		      LDAA	MONTH	; Next see if it is March or November
    562  f937		       81 0b		      CMPA	#11	; November is month number 11
    563  f939		       27 1c		      BEQ	NOVEMBER	; If it is November then check for return to standard time
    564  f93b		       81 03		      CMPA	#3	; Otherwise see if it is March
    565  f93d		       26 be		      BNE	IRET	; If it is not March either there is nothing more to do
    566  f93f		       96 c5		      LDAA	DAY	; Now see what day of the month it is
    567  f941		       44		      LSRA		; Shift out the daylight savings flag
    568  f942		       80 08		      SUBA	#8	; See if second week in March
    569  f944		       2d b7		      BLT	IRET	; If below then skip it
    570  f946		       81 08		      CMPA	#8	; See if above second seek
    571  f948		       2c b3		      BGE	IRET	; If so then skip it
    572  f94a							; Note - March 8 1984 was a Thursday
    573  f94a		       8b 04		      ADDA	#4	; Add 4 to get the day of week this would have been in 1984
    574  f94c		       8d 24		      BSR	DAY_OF_WEEK	; Now find out what day of the week it is this year
    575  f94e		       26 ad		      BNE	IRET	; If it is not Sunday (for which zero is returned), skip it
    576  f950		       96 98		      LDAA	TIME_OF_DAY	; Only if this is the second Sunday in March do we
    577  f952		       8b 06		      ADDA	#6	;  add one hour to the time
    578  f954		       97 98		      STAA	TIME_OF_DAY
    579  f956		       3b		      RTI
    580  f957
    581  f957							;; PAGE 15
    582  f957
    583  f957		       96 c5	   NOVEMBER   LDAA	DAY	; If this is November then see what the date is
