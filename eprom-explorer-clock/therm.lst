    594  f96c		       f9 6c	   DAY_OF_WEEK EQU	*	; Subroutine to correct the day of the week according
    595  f96c							;  to the year
    596  f96c							; Pass a value from 0 to 6 in A, returns a value from 0 to 6 in A
    597  f96c		       d6 9b		      LDAB	YEAR	; Get the value of the year, relative to 1984
    598  f96e		       c4 03		      ANDB	#ACC0+ACC1	; Get the value mod 4
    599  f970		       1b		      ABA		; Add one day for each non leap year past the last leap year
    600  f971		       d6 9b		      LDAB	YEAR	; Get the year again
    601  f973		       54		      LSRB		; look at just the other six bits in the year
    602  f974		       54		      LSRB
    603  f975		       c1 1d	   HUNDRED_YEAR CMPB	#(2100-1984)/4	; See if the year is greater than or
    604  f977							;  or equal to 2100
    605  f977		       25 06		      BLO	LEAP_YEARS	; If not then finish correcting leap years
    606  f979		       8b 05		      ADDA	#5	; In a normal period of 100 years there are 76 non leap years
    607  f97b							;  and 24 leap years, for a total shift of 124 days
    608  f97b							;  124 mod 7 is 5
    609  f97b		       c0 19		      SUBB	#100/4	; This correction is not made for the 100 year period
    610  f97d							;  which includes the year 2000, since it is a leap year
    611  f97d		       20 f6		      BRA	HUNDRED_YEAR	; Repeat the above in case the year is 2200 or later
    612  f97f
    613  f97f		       36	   LEAP_YEARS PSHA		; Save the day count on the stack
    614  f980		       86 05		      LDAA	#5	; multiply the number of leap years by 5
    615  f982		       3d		      MUL
    616  f983		       32		      PULA		; Get back the day couint
