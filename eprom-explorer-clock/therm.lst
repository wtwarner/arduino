    601  f972		       f9 72	   DAY_OF_WEEK EQU	*	; Subroutine to correct the day of the week according
    602  f972							;  to the year
    603  f972							; Pass a value from 0 to 6 in A, returns a value from 0 to 6 in A
    604  f972		       d6 9b		      LDAB	YEAR	; Get the value of the year, relative to 1984
    605  f974		       c4 03		      ANDB	#ACC0+ACC1	; Get the value mod 4
    606  f976		       1b		      ABA		; Add one day for each non leap year past the last leap year
    607  f977		       d6 9b		      LDAB	YEAR	; Get the year again
    608  f979		       54		      LSRB		; look at just the other six bits in the year
    609  f97a		       54		      LSRB
    610  f97b		       c1 1d	   HUNDRED_YEAR CMPB	#(2100-1984)/4	; See if the year is greater than or
    611  f97d							;  or equal to 2100
    612  f97d		       25 06		      BLO	LEAP_YEARS	; If not then finish correcting leap years
    613  f97f		       8b 05		      ADDA	#5	; In a normal period of 100 years there are 76 non leap years
    614  f981							;  and 24 leap years, for a total shift of 124 days
    615  f981							;  124 mod 7 is 5
    616  f981		       c0 19		      SUBB	#100/4	; This correction is not made for the 100 year period
    617  f983							;  which includes the year 2000, since it is a leap year
    618  f983		       20 f6		      BRA	HUNDRED_YEAR	; Repeat the above in case the year is 2200 or later
    619  f985
    620  f985		       36	   LEAP_YEARS PSHA		; Save the day count on the stack
    621  f986		       86 05		      LDAA	#5	; multiply the number of leap years by 5
