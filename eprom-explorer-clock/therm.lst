   1596  fe34							; Formatting routines
   1597  fe34
   1598  fe34							; What follows is a variety of formatting routines for various
   1599  fe34							; combinations of input and output information.  The output information
   1600  fe34							; is always a compbination of displayable digits returned in
   1601  fe34							; TEMP_BUF through TEMP_BUF+3
   1602  fe34
   1603  fe34							; Subroutine to display a two digit value from 0 to 99, with zero
   1604  fe34							; suppression on the first digit
   1605  fe34
   1606  fe34		       fe 34	   DISP_TWO   EQU	*	; The value to be formatted is passed in B
   1607  fe34		       86 cd		      LDAA	#205	; The first objective is to multiple by 1/10 and separate
   1608  fe36		       3d		      MUL		;  the whole number and fraction parts of the result
   1609  fe37		       04		      LSRD		; Since the value 205 is about eight times 256/10, shift the
   1610  fe38		       04		      LSRD		;  answer down 3 bits and whole number will be in A and
   1611  fe39		       04		      LSRD		;  the fraction in B
   1612  fe3a		       37		      PSHB		; Save the fraction temporarily on the stack
   1613  fe3b		       16		      TAB		; Copy the whole number into B
   1614  fe3c		       27 06		      BEQ	SUPP_TWO	; If the whole number part is zero, supress it
   1615  fe3e		       ce fe bd    END_TWO    LDX	#DIGIT_TAB	; If it is not zero then index into a lookup
   1616  fe41		       3a		      ABX		;  table to get the bits for this digit
   1617  fe42		       a6 00		      LDAA	0,X
   1618  fe44		       33	   SUPP_TWO   PULB		; Get the fraction back off the stack
   1619  fe45		       97 df		      STAA	TEMP_BUF+2	; Save the first digit in the buffer
   1620  fe47		       86 0a		      LDAA	#10	; Now multiply the fraction by ten to get the second digit
   1621  fe49		       3d		      MUL
   1622  fe4a		       89 00		      ADCA	#0	; Round up to prevent truncation errors
   1623  fe4c		       16		      TAB		; Copy the digit into B
   1624  fe4d		       ce fe bd 	      LDX	#DIGIT_TAB	; Also index into the table
   1625  fe50		       3a		      ABX		; Do not do zero supression since this is the last digit
   1626  fe51		       e6 00		      LDAB	0,X	; Get the segments bits
   1627  fe53		       d7 e0		      STAB	TEMP_BUF+3	; Save the second digit in the buffer
   1628  fe55		       96 df		      LDAA	TEMP_BUF+2	; Return both digita in registers as well in case
   1629  fe57		       39		      RTS		;  the calling routine wants to write them into another location
   1630  fe58
   1631  fe58							;; PAGE 43
   1632  fe58
   1633  fe58							; Subroutine to display a four digit vlaue from -999 to 2999, with
   1634  fe58							; zero suppression on the first two digits
   1635  fe58
   1636  fe58		       fe 58	   DISP_FOUR  EQU	*	; The value to be formatted is pass in A and B
   1637  fe58		       dd d9		      STD	TEMP	; Save the unmodified vlue to be formatted
   1638  fe5a		       2a 0a		      BPL	PLUS_FOUR	; Test the sign at the same time
   1639  fe5c		       86 02		      LDAA	#SEGG	; If the value is negative, then maket he first digit '-'
   1640  fe5e		       97 dd		      STAA	TEMP_BUF	; Write this character into the first digit in the buffer
   1641  fe60		       4f		      CLRA		; Now negate the negative value to give a positive number
   1642  fe61		       5f		      CLRB		;  to be formatted
   1643  fe62		       93 d9		      SUBD	TEMP
   1644  fe64		       20 1b		      BRA	CONTIN_FOUR	; Skip ahead to the second digit formatting
   1645  fe66		       83 03 e8    PLUS_FOUR  SUBD	#1000	; If the value is positive, see if it is more
   1646  fe69		       24 03		      BHS	ONE_THOUSAND	;  than 999
   1647  fe6b		       4f		      CLRA		; If not then make the first digit blank
   1648  fe6c		       20 0f		      BRA	SAVE_FIRST	; Push it onto the stack and continue from there
   1649  fe6e
   1650  fe6e		       dd d9	   ONE_THOUSAND STD	TEMP	; If the value is more than 999 then save the
   1651  fe70							;  value less than one thousand
   1652  fe70		       83 03 e8 	      SUBD	#1000	; See if the remainder is still more then 999
   1653  fe73		       24 04		      BHS	TWO_THOUSAND	; If it is then the first digit is assumed to be 2
   1654  fe75		       86 28		      LDAA	#ONE	; But if not then make the first digit 1
   1655  fe77		       20 04		      BRA	SAVE_FIRST	; Push it on the stack and continue from there
   1656  fe79
   1657  fe79		       dd d9	   TWO_THOUSAND STD	TEMP	; If the value is more than 1999 the save
   1658  fe7b							;  the value less two thousand
   1659  fe7b		       86 e6		      LDAA	#TWO	; Make the first digit 2
   1660  fe7d		       97 dd	   SAVE_FIRST STAA	TEMP_BUF	; Save it in the buffer
   1661  fe7f		       dc d9		      LDD	TEMP	; Get the value mod 1000
   1662  fe7f		       fe 81	   CONTIN_FOUR EQU	*
   1663  fe81		       ce fe bc 	      LDX	#DIGIT_TAB-1	; Point to the table of digit patterns
   1664  fe84		       08	   SUB_100    INX		; Keep incrementing into this table and subtracting 100 from
   1665  fe85		       83 00 64 	      SUBD	#100	;  the value until it goes negative
   1666  fe88		       24 fa		      BHS	SUB_100	; As soon as it goes negative we are pointing to the digit
   1667  fe8a							;  to be displayed
   1668  fe8a		       cb 64		      ADDB	#100	; Cancel the extra subtraction
   1669  fe8c		       a6 00		      LDAA	0,X	; Load the second digit from the lookup table
   1670  fe8e		       81 fc		      CMPA	#ZERO	; See if the second digit is a zero
   1671  fe90		       26 0a		      BNE	SEC_NOT_ZERO	; If second digit is zero then should it be blanked
   1672  fe92		       96 dd		      LDAA	TEMP_BUF	; Look at the first digit
   1673  fe94		       27 06		      BEQ	BLANK_SECOND	; If first digit is blank then blank second
   1674  fe96		       80 02		      SUBA	#SEGG	; Also, if the first digit is '-' then blank second
   1675  fe98		       27 02		      BEQ	BLANK_SECOND
   1676  fe9a		       86 fc		      LDAA	#ZERO	; Otherwise put an actual zero that digit
   1677  fe9a		       fe 9c	   BLANK_SECOND EQU	*	; Either a zero or a blank will be pushed next
   1678  fe9c		       97 de	   SEC_NOT_ZERO STAA	TEMP_BUF+1	; Save the second digit, whatever it is
   1679  fe9e		       86 cd		      LDAA	#205	; Duplicate the first part of the routine above for
   1680  fea0		       3d		      MUL		;  formatting a two digit number, so that we can enter that
   1681  fea1		       04		      LSRD		;  routine and format the last two digita without allowing
   1682  fea2		       04		      LSRD		;  the first digit to be blanked
   1683  fea3		       04		      LSRD
   1684  fea4		       37		      PSHB
   1685  fea5		       16		      TAB
   1686  fea6		       20 96		      BRA	END_TWO	; Now jump into the two digit formatter
   1687  fea8
