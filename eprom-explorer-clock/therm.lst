   1257  fc38		       53		      COMB		; Blank those whose select big was zero
   1258  fc39		       86 10		      LDAA	#$10	; Shift it up to the upper four bits
   1259  fc3b		       3d		      MUL
   1260  fc3c		       7e fd 4c 	      JMP	BLANK_DISP	; Blank and copy the digits
   1261  fc3f
   1262  fc3f		       fc 3f	   NOT_DISP_ALT EQU	*	; The only other special mode is RAM contents
