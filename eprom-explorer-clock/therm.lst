    542  f91c		       7c 00 d2 	      INC	TODAY_MEAN3
    543  f91f
    544  f91f		       7c 00 9e    NO_CARRY3  INC	MEAN_COUNT	; Increment the counter to show that one more value has
    545  f922							;  been summed in
    546  f922		       96 98		      LDAA	TIME_OF_DAY	; Now increment the time-of-day counter by ten minutes
    547  f924		       4c		      INCA
    548  f925		       81 90		      CMPA	#6*24	; See if it is midnight
    549  f927		       24 61		      BHS	MIDNIGHT	; If it isi then take care of any daily chores
    550  f929		       97 98		      STAA	TIME_OF_DAY	; Otherwise save the incremented time
    551  f92b		       81 0c		      CMPA	#6*2	; Now see if it is 2AM
    552  f92d		       26 ce		      BNE	IRET	; If not then we are done for now
    553  f92f		       96 02		      LDAA	PORT1	; If it is 2AM then there is a possibility that we need to
    554  f931		       85 20		      BITA	#DST_JUMPER	;  adjust for daylight saving time
    555  f933		       26 c8		      BNE	IRET	; If the jumper has been removed then daylight saving time is
    556  f935							;  disabled.
    557  f935		       96 c8		      LDAA	MONTH	; Next see if it is April or October
    558  f937		       81 0a		      CMPA	#10	; October is month number 10
    559  f939		       27 18		      BEQ	OCTOBER	; If it is October then check for return to standard time
    560  f93b		       81 04		      CMPA	#4	; Otherwise see if it is April
    561  f93d		       26 be		      BNE	IRET	; If it is not April either there is nothing more to do
    562  f93f		       96 c5		      LDAA	DAY	; Now see what day of the month it is
    563  f941		       44		      LSRA		; Shift out the daylight savings flag
    564  f942		       80 18		      SUBA	#24	; See if this is last week in April
    565  f944		       25 b7		      BLO	IRET	; If not then skip it
    566  f946							; Note - April 24 1984 was a Tuesday
    567  f946		       8b 02		      ADDA	#2	; Add 2 to get the day of week this would have been in 1984
    568  f948		       8d 22		      BSR	DAY_OF_WEEK	; Now find out what day of the week it is this year
    569  f94a		       26 b1		      BNE	IRET	; If it is not Sunday (for which zero is returned), skip it
    570  f94c		       96 98		      LDAA	TIME_OF_DAY	; Only if this is the last Sunday in April do we
    571  f94e		       8b 06		      ADDA	#6	;  add one hour to the time
    572  f950		       97 98		      STAA	TIME_OF_DAY
    573  f952		       3b		      RTI
    574  f953
    575  f953							;; PAGE 15
    576  f953
    577  f953		       96 c5	   OCTOBER    LDAA	DAY	; If this is October then see what the date is
    578  f955		       44		      LSRA		; Shift out the daylight saving flag
