    824  fa54							;; PAGE 21 DISPLAY MODE ROUTINES
    825  fa54
    826  fa54							; Main Program
    827  fa54							; The main program consists basically of four mode routines. The
    828  fa54							; primary mode routine is the display routine. The one in which each
    829  fa54							; of the pieces of information is individually displayed and selected
    830  fa54							; by processing the three buttons.  Next there is the alternate display
    831  fa54							; routine in which several pices of information are displayed
    832  fa54							; alternately over a period of several seconds. Then there is the
    833  fa54							; set mode in which setpoints are entered for several parameters,
    834  fa54							; such as the time and date.  Finally, there is a diagnostic mode in
    835  fa54							; which information aobut the functioning of the hardware itself
    836  fa54							; can be displayed. To go from the display routine to any of the
    837  fa54							; others requires that two keys be pressed simultaneously.
    838  fa54
    839  fa54							; DISPLAY ROUTINE
    840  fa54
    841  fa54		       fa 54	   DISPLAY_MODE EQU	*	; This is the main mode of operation of this
    842  fa54							;  instrument. It is used to display any of 68 different pieces of
    843  fa54							;  information one at a time.	The information is selected by pressing
    844  fa54							;  the tree front panel switches one at a time to specify three
    845  fa54							;  identifiers of the information to be displayed. First there is
    846  fa54							;  switch 1, which specifies whether the information is a centegrade
    847  fa54							;  temperature, fahrenheit temperature, a time of date or a date.
    848  fa54							;  Next, switch 2 specifies whether the information refers to
    849  fa54							;  temperature zones 1, 2 or 3. Finally, switch 3 specifies whether
    850  fa54							;  the information is the current value, the maximum or minimum
    851  fa54							;  value so far today, the mean value so far today, or yesterday's
    852  fa54							;  maximum, minimum or mean.
    853  fa54		       dc d5		      LDD	DISP_SELECT	; Get the 2 byte value which specifies the
    854  fa56							;  information to be displayed
    855  fa56		       bd fc 18 	      JSR	BACKGROUND	; Format and display the information
    856  fa59							; This major routine does much more than just format display data
    857  fa59							;  and read the keyboard, which is the last thing it does
    858  fa59							;  before returning
    859  fa59		       44		      LSRA		; The keyboard is returned in the low 3 bits of A
    860  fa5a		       25 21		      BCS	INC_SW1	; If bit 0 was set then switch 1 was just pressed
    861  fa5c		       44		      LSRA		; If switch 1 was not just pressed then see if switch 2 was
    862  fa5d		       25 12		      BCS	INC_SW2	; If bit 1 was set then switch 2 was just pressed
    863  fa5f		       27 f3		      BEQ	DISPLAY_MODE	; If switches 1 and 2 were not pressed and bit 2
    864  fa61							;  is also zero then none of the switches was pressed, so
    865  fa61							;  just continue to display the same information
    866  fa61							; If bit 2 is set then increment the switch 3 selection bits
    867  fa61
    868  fa61							; PAGE 22 DISPLAY MODE ROUTINES
    869  fa61
    870  fa61							; Increment the switch 3 selection bitts
    871  fa61		       96 d5		      LDAA	DISP_SELECT	; This byte contains the selection bits for both
    872  fa63							;  switch 1 and switch 3
    873  fa63		       8b 04		      ADDA	#ACC2	; Leave the two low bits alone and increment the next 3 bits
    874  fa65		       81 1c		      CMPA	#7*ACC2	; See if these bits have reached a value of 7
    875  fa67		       25 02		      BLO	NOT7	; If they have then
    876  fa69		       84 03		      ANDA	#ACC0+ACC1	;  start them over again at zero
    877  fa6b		       84 fd	   NOT7       ANDA	#$FF-ACC1	; If the mode is time or date then set it to C or F
    878  fa6d		       97 d5		      STAA	DISP_SELECT	; Return the selection bits
    879  fa6f		       20 e3		      BRA	DISPLAY_MODE	; Repeat the loop with the new select bits
    880  fa71
    881  fa71							; Increment the switch 2 selection bits
    882  fa71		       fa 71	   INC_SW2    EQU	*	; Increment the zone selection bits
    883  fa71		       d6 d6		      LDAB	ZONE_SELECT	; Get the current value of these bits
    884  fa73		       5c		      INCB		; Increment to the next value
    885  fa74		       c1 02		      CMPB	#2	; See if we have incremented past the last zone
    886  fa76		       23 01		      BLS	IS_LESS	; If we have then
    887  fa78		       5f		      CLRB		;  start over at zone 1
    888  fa79		       d7 d6	   IS_LESS    STAB	ZONE_SELECT	; Save the new value
    889  fa7b		       20 d7		      BRA	DISPLAY_MODE	; Repeat the loop with the new select bits
    890  fa7d
    891  fa7d							; Increment the switch 1 selection bits
    892  fa7d		       fa 7d	   INC_SW1    EQU	*	; Increment the data type selection bits
    893  fa7d		       d6 d5		      LDAB	DISP_SELECT	; Get the current value of these bits
    894  fa7f		       5c	   SKIP_MODE  INCB		; Increment to the next value
    895  fa80		       c5 03		      BITB	#ACC0+ACC1	; See if they have been incremented to zero
    896  fa82		       27 16		      BEQ	TO_C	; If they have then go cancel out the carry into the upper bits
    897  fa84		       c5 02		      BITB	#ACC1	; If not zero then are they 01 (Fahrenheit)
    898  fa86		       27 14		      BEQ	TO_F	; If so then just save the new value
    899  fa88		       c5 fc		      BITB	#$FF-ACC0-ACC1	; See if we are reading current value
    900  fa8a		       27 10		      BEQ	TO_F	; If we are then this is legal for both date and time
    901  fa8c		       c5 01		      BITB	#ACC0	; If not current then see if we are set to date
    902  fa8e		       26 ef		      BNE	SKIP_MODE	; If so then the combination is illegal, go to the next
    903  fa90		       c1 0e		      CMPB	#3*ACC2+2	; For time the only illegal combinations are today's
    904  fa92		       27 eb		      BEQ	SKIP_MODE	;  mean and yesterday's mean
    905  fa94		       c1 1a		      CMPB	#6*ACC2+2
    906  fa96		       27 e7		      BEQ	SKIP_MODE
    907  fa98		       20 02		      BRA	TO_F	; Otherwise save this value as is
    908  fa9a
    909  fa9a		       c0 04	   TO_C       SUBB	#4	; Cancel the carry from the low bits
    910  fa9c		       d7 d5	   TO_F       STAB	DISP_SELECT	; Save the new value of the bits
    911  fa9e		       20 b4		      BRA	DISPLAY_MODE	; Repeat the loop with the new select bits
    912  faa0
    913  faa0							;; PAGE 23 DISPLAY MODE ROUTINES
    914  faa0
    915  faa0							; Alternate display routine
    916  faa0		       fa a0	   ALT_MODE   EQU	*	; This is a display mode in which two or more pieces
    917  faa0							;  of information can be displayed in sequence at intervals of a few
    918  faa0							;  seconds. The mode is initially entered by pressing both S1 and S2
    919  faa0							;  simultaneously. While in this mode the action of the three switches
    920  faa0							;  is modified. S1 is now used to step more quickly through the
    921  faa0							;  display sequence, or to hold the display on a particular value by
    922  faa0							;  holding the switch in.  S2 is used to select a different zone to
    923  faa0							;  be displayed while on either degrees C or degrees F. S3 is used
    924  faa0							;  to exit from this mode and return to normal display mode.
    925  faa0		       dc d5		      LDD	DISP_SELECT	; Display the currently selected item
    926  faa2		       bd fc 18 	      JSR	BACKGROUND	;  and read the keyboard
    927  faa5		       44		      LSRA		; See if switch 1 was just pressed
    928  faa6		       25 14		      BCS	ADVANCE_ALT	; If it was then advance to the next display item
    929  faa8		       44		      LSRA		; See if switch 2 was just pressed
    930  faa9		       25 2c		      BCS	ALT_ZONE	; If it was then advance to the next zone
    931  faab		       44		      LSRA		; See if switch 3 was just pressed
    932  faac		       25 a6		      BCS	DISPLAY_MODE	; If it was then exit from this mode
    933  faae		       c5 01		      BITB	#ACC0	; If nothing just pressed then is switch 1 being held in
    934  fab0		       26 ee		      BNE	ALT_MODE	; If it is then hold the display on this item
    935  fab2		       96 92	   ADVANCE_YET LDAA	TWENTIETHS	; See if it is time to advance the item
    936  fab4		       81 31		      CMPA	#49
    937  fab6		       27 04		      BEQ	ADVANCE_ALT
    938  fab8		       81 6d		      CMPA	#109
    939  faba		       26 e4		      BNE	ALT_MODE
    940  faba		       fa bc	   ADVANCE_ALT EQU	*	; Three seconds have elapsed
    941  fabc		       96 d5		      LDAA	DISP_SELECT	; Get the corrent select bits
    942  fabe		       4c		      INCA		; Advance to the next item
    943  fabf		       84 03	   VALIDATE_ALT ANDA	#3	; Allow current values only
    944  fac1		       97 d5		      STAA	DISP_SELECT	; Put back the new select bits
    945  fac3		       d6 cb		      LDAB	ALT_SELECT	; See which items are selected for alternate display
    946  fac5		       58		      LSLB		; only the low 4 bits are used, one for each item
    947  fac6		       58		      LSLB
    948  fac7		       58		      LSLB
    949  fac8		       58		      LSLB
    950  fac9		       27 18		      BEQ	BAD_ALT	; If none of these bits is set then set some, so that we
    951  facb							;  cannot accidentally get hung up here forever
    952  facb		       58	   TEST_ALT   LSLB		; Shift the first select bit into the carry
    953  facc		       4a		      DECA		; See if this is the right bit to test
    954  facd		       2a fc		      BPL	TEST_ALT	; No, not yet - look at the next bit
    955  facf		       24 eb		      BCC	ADVANCE_ALT	; If this item is not enabled then try the next one
    956  fad1		       20 cd		      BRA	ALT_MODE	; Otherwise go ahead and display this item
    957  fad3
    958  fad3		       96 d5	   ENTER_ALT  LDAA	DISP_SELECT	; Enter this mode here to immediately start
    959  fad5		       20 e8		      BRA	VALIDATE_ALT	;  displaying a valid mode
    960  fad7
    961  fad7							;; PAGE 24 DISPLAY MODE ROUTINES
    962  fad7
    963  fad7							; Select the next zone while in alternate display mode
    964  fad7		       96 d6	   ALT_ZONE   LDAA	ZONE_SELECT	; Select the next mode
    965  fad9		       4c		      INCA
    966  fada		       81 03		      CMPA	#3	; See if we have passed zone 3
    967  fadc		       25 01		      BLO	NOT_THREE
    968  fade		       4f		      CLRA		; If so then drop back to zone 1
    969  fadf		       97 d6	   NOT_THREE  STAA	ZONE_SELECT
    970  fae1		       20 cf		      BRA	ADVANCE_YET	; Now execute the remainder of the above routine
    971  fae3
    972  fae3		       7a 00 cb    BAD_ALT    DEC	ALT_SELECT	; If noe of the select bits were set then
    973  fae6							;  set them all
    974  fae6		       20 b8		      BRA	ALT_MODE	; Go ahead and display the current one
    975  fae8
    976  fae8							;; PAGE 25 DISPLAY MODE ROUTINES
    977  fae8
    978  fae8							; Set time and date routine
    979  fae8		       fa e8	   SET_MODE   EQU	*	; This is a display mode in which the time and date
    980  fae8							;  settings can be adjusted.  The mode is initially entered by pressing
    981  fae8							;  both s1 and s3 simultaneiously. Whiel in this mode S1 selects the
    982  fae8							;  next setting to be adjusted, S2 increments its value and S3
    983  fae8							;  decrements it.  After the last setting has been displayed and
    984  fae8							;  possibly adjusted, pressing s1 one more time returns to normal
    985  fae8							;  display mode.
    986  fae8		       cc 07 0b 	      LDD	#$070B	; Special select value to display the year and suppress
    987  faeb							;  other indicator lights
