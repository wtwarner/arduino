   1227  fc18							;; PAGE 32 BACKGROUND ROUTINE
   1228  fc18
   1229  fc18							; Main background routine
   1230  fc18							; At present this routine performs three functions: it formats
   1231  fc18							; information to be displayed, using a select code passed to it in
   1232  fc18							; the A and B registers; it waits for 1/20 second to elapse and
   1233  fc18							; completes a handshake with the foreground routine; and it reads
   1234  fc18							; the keyboard and decides which keys have just been pressed.	As
   1235  fc18							; long as no more than one key is pressed at a time, it the returns
   1236  fc18							; with this keyboard information to the same routine which had
   1237  fc18							; called it, but as soon as two keys are pressed simultaneiously it
   1238  fc18							; discards the return address and goes instead to one of three
   1239  fc18							; special routines
   1240  fc18
   1241  fc18		       fc 18	   BACKGROUND EQU	*
   1242  fc18		       4d		      TSTA		; First, see if the display mode is one of the special ones
   1243  fc19		       2a 48		      BPL	NOT_SPECIAL	; If the MSB is not set then standard display mode
   1244  fc1b		       48		      LSLA		; IF the MSB is set then test the next bit as well
   1245  fc1c		       2a 0c		      BPL	NOT_CONST	; if this bit is set then one of the constant patterns
   1246  fc1e							;  is to be displayed
   1247  fc1e		       cc ff ff 	      LDD	#$FFFF	; Presently the only constant pattern is the one with
   1248  fc21		       dd 85		      STD	MSD	;  all segments and lights on
   1249  fc23		       dd 87		      STD	MSD+2
   1250  fc25		       dd 89		      STD	MSD+4
   1251  fc27		       7e fd 84 	      JMP	END_DISP	; Skip the digit blanking and copying from the temporary
   1252  fc2a							;  buffer
   1253  fc2a
   1254  fc2a							;; PAGE 33
   1255  fc2a		       48	   NOT_CONST  LSLA		; If the information to be displayed is not constant,
   1256  fc2b		       2a 18		      BPL	NOT_DISP_ALT	;  see if it is alternate select mode
   1257  fc2d		       cc d4 56 	      LDD	#C*$100+F	; If it is then display the characters 'CFHd'
   1258  fc30		       dd dd		      STD	TEMP_BUF
   1259  fc32		       cc 7a ea 	      LDD	#H*$100+D
   1260  fc35		       dd df		      STD	TEMP_BUF+2
   1261  fc37		       cc 60 f8 	      LDD	#SET+DEGC+DEGF+AM+PM+DATE+CURR	; Turn on all these indicator lights
   1262  fc3a		       dd e1		      STD	TEMP_BUF+4	;  to show this mode
   1263  fc3c		       d6 cb		      LDAB	ALT_SELECT	; See which of these to blank
   1264  fc3e		       53		      COMB		; Blank those whose select big was zero
   1265  fc3f		       86 10		      LDAA	#$10	; Shift it up to the upper four bits
   1266  fc41		       3d		      MUL
   1267  fc42		       7e fd 52 	      JMP	BLANK_DISP	; Blank and copy the digits
   1268  fc45
   1269  fc45		       fc 45	   NOT_DISP_ALT EQU	*	; The only other special mode is RAM contents
   1270  fc45		       d6 80		      LDAB	RAM_PTR	; Format the address first
   1271  fc47		       ca 80		      ORAB	#$80	; Display its real value, with MSB set
   1272  fc49		       37		      PSHB		; Save the address for later
   1273  fc4a		       bd fe ae 	      JSR	DISP_HEX	; Format it as two digit hex
   1274  fc4d		       dd 85		      STD	MSD	; Write it directly to the display buffer
   1275  fc4f		       33		      PULB		; Get the address again
   1276  fc50		       ce 00 00 	      LDX	#0	; This time use it to fetch the contents
   1277  fc53		       3a		      ABX		; Form the complet address in X
   1278  fc54		       e6 00		      LDAB	0,X	; Load the contents
   1279  fc56		       bd fe ae 	      JSR	DISP_HEX	; Format it
   1280  fc59		       dd 87		      STD	MSD+2	; Write it to the display buffer
   1281  fc5b		       cc 3f ff 	      LDD	#$FFFF-COLON-SET	; Turn on nearly all the indicator lights
   1282  fc5e		       dd 89		      STD	MSD+4	;  in this mode
   1283  fc60		       7e fd 84 	      JMP	END_DISP	; No need to blank digits or copy to display RAM
   1284  fc63
   1285  fc63							;; PAGE 34
   1286  fc63		       37	   NOT_SPECIAL PSHB		; If none of the special display modes then save
   1287  fc64		       44		      LSRA		;  the zone selector and shift out the data type selector
   1288  fc65		       76 00 dd 	      ROR	TEMP_BUF	; The LSB of the data type selector is saved for later
