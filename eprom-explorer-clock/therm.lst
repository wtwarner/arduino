    751  f9fd							;; PAGE 19 - CLOCK TIMER INTERRUPT SERVICING
    752  f9fd
    753  f9fd							; Subroutine to calculate the average value from the sum of the
    754  f9fd							; values and the number of values summed.
    755  f9fd		       f9 fd	   AVERAGE    EQU	*
    756  f9fd		       86 11		      LDAA	#17	; Go through the divide loop 17 times but only save 16 bits
    757  f9ff							;  of quotient
    758  f9ff		       36		      PSHA		; Push the counter byte onto the stack
    759  fa00		       a6 02		      LDAA	2,X	; X points to the sum, so 2,x is the third byte of the sum
    760  fa02		       36		      PSHA		; Use another stack location for this byte
    761  fa03		       ec 00		      LDD	0,X	; Now load the first two bytes of the sum
    762  fa05		       30		      TSX		; Make X now point to the two bytes which were placed on the stack
    763  fa06		       0c		      CLC		; Clear the carry to prevent A 1 from getting shifted in below
    764  fa07		       69 00	   AVG_DIVIDE ROL	0,X	; Shift the quotient and remainder left one bit
    765  fa09		       59		      ROLB		; The lowest of these three bytes is on the stack, then other
    766  fa0a		       49		      ROLA		;  two in B and A
    767  fa0b		       25 04		      BCS	SUBTRACT	; If a non-zero bit of the remainder shifts out the top
    768  fa0d							;  then force a subtraction
    769  fa0d		       91 9e		      CMPA	MEAN_COUNT	; Otherwise decide whether or not to subtract based
    770  fa0f		       25 03		      BLO	NO_SUBTRACT	;  on whther the remainder is greater or less than
    771  fa11							;  the number being divided by, the number of summed values
    772  fa11		       90 9e	   SUBTRACT   SUBA	MEAN_COUNT	; Every time the remainder is large enough,
    773  fa13		       0c		      CLC		;  subtract the divisor and shift in a zero for the quotient
    774  fa13		       fa 14	   NO_SUBTRACT EQU	*	; Every time it is too small, shift in a one
    775  fa14		       6a 01		      DEC	1,X	; See if 17 passes have been made through the above loop
    776  fa16		       26 ef		      BNE	AVG_DIVIDE	; Repeat until done
    777  fa18							; After 17 passes, the 16 bit quotient is in B and the top byte of
    778  fa18							; the stack, in complemented form, and the seventeenth bit of the
    779  fa18							; quotient, also complemented, is in the carry flag
    780  fa18		       17		      TBA		; Move the first byte of quotient to register A
    781  fa19		       33		      PULB		; Move the second byte to B
    782  fa1a		       31		      INS		; Discard the counter from the stack
    783  fa1b		       25 03		      BCS	NO_CARRY	; Use the next bit of the quotient for rounding
    784  fa1d		       83 00 01 	      SUBD	#1	; At this point all bits are still complemented so the
    785  fa20							;  'branch if carry clear' and 'increment double' instructions
    786  fa20							;  are instead 'branch if carry set' and 'decrement double'
    787  fa20		       43	   NO_CARRY   COMA		; Finally convert the rounded qoutient from complemented to
    788  fa21		       53		      COMB		;  true form and return
    789  fa22		       39		      RTS
    790  fa23
    791  fa23							;; PAGE 20 CLOCK TIMER INTERRUPT SERVICING
    792  fa23
    793  fa23							; Subroutine to initialize today's minimum, maximum, and mean values
    794  fa23
    795  fa23		       fa 23	   INIT_MINMAX EQU	*
    796  fa23		       dc 8d		      LDD	CONV_BUF	; Take the current values of the zones
    797  fa25		       dd cd		      STD	TODAY_MEAN1+1	; Initialize the sum, the minimum, and the maximum
    798  fa27		       dd 9f		      STD	TODAY_MIN1	;  to this value
    799  fa29		       dd a8		      STD	TODAY_MAX1
    800  fa2b		       dc 90		      LDD	CONV_BUF+3
    801  fa2d		       dd d0		      STD	TODAY_MEAN2+1
    802  fa2f		       dd a2		      STD	TODAY_MIN2
    803  fa31		       dd ab		      STD	TODAY_MAX2
    804  fa33		       dc 93		      LDD	CONV_BUF+6
    805  fa35		       dd d3		      STD	TODAY_MEAN3+1
    806  fa37		       dd a5		      STD	TODAY_MIN3
    807  fa39		       dd ae		      STD	TODAY_MAX3
