   1602  fe3a
   1603  fe3a							; Formatting routines
   1604  fe3a
   1605  fe3a							; What follows is a variety of formatting routines for various
   1606  fe3a							; combinations of input and output information.  The output information
   1607  fe3a							; is always a compbination of displayable digits returned in
   1608  fe3a							; TEMP_BUF through TEMP_BUF+3
   1609  fe3a
   1610  fe3a							; Subroutine to display a two digit value from 0 to 99, with zero
   1611  fe3a							; suppression on the first digit
   1612  fe3a
   1613  fe3a		       fe 3a	   DISP_TWO   EQU	*	; The value to be formatted is passed in B
   1614  fe3a		       86 cd		      LDAA	#205	; The first objective is to multiple by 1/10 and separate
   1615  fe3c		       3d		      MUL		;  the whole number and fraction parts of the result
   1616  fe3d		       04		      LSRD		; Since the value 205 is about eight times 256/10, shift the
   1617  fe3e		       04		      LSRD		;  answer down 3 bits and whole number will be in A and
   1618  fe3f		       04		      LSRD		;  the fraction in B
   1619  fe40		       37		      PSHB		; Save the fraction temporarily on the stack
   1620  fe41		       16		      TAB		; Copy the whole number into B
   1621  fe42		       27 06		      BEQ	SUPP_TWO	; If the whole number part is zero, supress it
   1622  fe44		       ce fe c3    END_TWO    LDX	#DIGIT_TAB	; If it is not zero then index into a lookup
   1623  fe47		       3a		      ABX		;  table to get the bits for this digit
   1624  fe48		       a6 00		      LDAA	0,X
   1625  fe4a		       33	   SUPP_TWO   PULB		; Get the fraction back off the stack
   1626  fe4b		       97 df		      STAA	TEMP_BUF+2	; Save the first digit in the buffer
   1627  fe4d		       86 0a		      LDAA	#10	; Now multiply the fraction by ten to get the second digit
   1628  fe4f		       3d		      MUL
   1629  fe50		       89 00		      ADCA	#0	; Round up to prevent truncation errors
   1630  fe52		       16		      TAB		; Copy the digit into B
   1631  fe53		       ce fe c3 	      LDX	#DIGIT_TAB	; Also index into the table
   1632  fe56		       3a		      ABX		; Do not do zero supression since this is the last digit
   1633  fe57		       e6 00		      LDAB	0,X	; Get the segments bits
   1634  fe59		       d7 e0		      STAB	TEMP_BUF+3	; Save the second digit in the buffer
   1635  fe5b		       96 df		      LDAA	TEMP_BUF+2	; Return both digita in registers as well in case
   1636  fe5d		       39		      RTS		;  the calling routine wants to write them into another location
   1637  fe5e
   1638  fe5e							;; PAGE 43
   1639  fe5e
   1640  fe5e							; Subroutine to display a four digit vlaue from -999 to 2999, with
   1641  fe5e							; zero suppression on the first two digits
   1642  fe5e
   1643  fe5e		       fe 5e	   DISP_FOUR  EQU	*	; The value to be formatted is pass in A and B
   1644  fe5e		       dd d9		      STD	TEMP	; Save the unmodified vlue to be formatted
   1645  fe60		       2a 0a		      BPL	PLUS_FOUR	; Test the sign at the same time
   1646  fe62		       86 02		      LDAA	#SEGG	; If the value is negative, then maket he first digit '-'
   1647  fe64		       97 dd		      STAA	TEMP_BUF	; Write this character into the first digit in the buffer
   1648  fe66		       4f		      CLRA		; Now negate the negative value to give a positive number
   1649  fe67		       5f		      CLRB		;  to be formatted
   1650  fe68		       93 d9		      SUBD	TEMP
   1651  fe6a		       20 1b		      BRA	CONTIN_FOUR	; Skip ahead to the second digit formatting
   1652  fe6c		       83 03 e8    PLUS_FOUR  SUBD	#1000	; If the value is positive, see if it is more
   1653  fe6f		       24 03		      BHS	ONE_THOUSAND	;  than 999
   1654  fe71		       4f		      CLRA		; If not then make the first digit blank
   1655  fe72		       20 0f		      BRA	SAVE_FIRST	; Push it onto the stack and continue from there
   1656  fe74
   1657  fe74		       dd d9	   ONE_THOUSAND STD	TEMP	; If the value is more than 999 then save the
   1658  fe76							;  value less than one thousand
   1659  fe76		       83 03 e8 	      SUBD	#1000	; See if the remainder is still more then 999
   1660  fe79		       24 04		      BHS	TWO_THOUSAND	; If it is then the first digit is assumed to be 2
   1661  fe7b		       86 28		      LDAA	#ONE	; But if not then make the first digit 1
   1662  fe7d		       20 04		      BRA	SAVE_FIRST	; Push it on the stack and continue from there
   1663  fe7f
   1664  fe7f		       dd d9	   TWO_THOUSAND STD	TEMP	; If the value is more than 1999 the save
   1665  fe81							;  the value less two thousand
   1666  fe81		       86 e6		      LDAA	#TWO	; Make the first digit 2
   1667  fe83		       97 dd	   SAVE_FIRST STAA	TEMP_BUF	; Save it in the buffer
   1668  fe85		       dc d9		      LDD	TEMP	; Get the value mod 1000
   1669  fe85		       fe 87	   CONTIN_FOUR EQU	*
   1670  fe87		       ce fe c2 	      LDX	#DIGIT_TAB-1	; Point to the table of digit patterns
   1671  fe8a		       08	   SUB_100    INX		; Keep incrementing into this table and subtracting 100 from
   1672  fe8b		       83 00 64 	      SUBD	#100	;  the value until it goes negative
   1673  fe8e		       24 fa		      BHS	SUB_100	; As soon as it goes negative we are pointing to the digit
   1674  fe90							;  to be displayed
   1675  fe90		       cb 64		      ADDB	#100	; Cancel the extra subtraction
   1676  fe92		       a6 00		      LDAA	0,X	; Load the second digit from the lookup table
   1677  fe94		       81 fc		      CMPA	#ZERO	; See if the second digit is a zero
   1678  fe96		       26 0a		      BNE	SEC_NOT_ZERO	; If second digit is zero then should it be blanked
   1679  fe98		       96 dd		      LDAA	TEMP_BUF	; Look at the first digit
   1680  fe9a		       27 06		      BEQ	BLANK_SECOND	; If first digit is blank then blank second
   1681  fe9c		       80 02		      SUBA	#SEGG	; Also, if the first digit is '-' then blank second
   1682  fe9e		       27 02		      BEQ	BLANK_SECOND
   1683  fea0		       86 fc		      LDAA	#ZERO	; Otherwise put an actual zero that digit
   1684  fea0		       fe a2	   BLANK_SECOND EQU	*	; Either a zero or a blank will be pushed next
   1685  fea2		       97 de	   SEC_NOT_ZERO STAA	TEMP_BUF+1	; Save the second digit, whatever it is
   1686  fea4		       86 cd		      LDAA	#205	; Duplicate the first part of the routine above for
   1687  fea6		       3d		      MUL		;  formatting a two digit number, so that we can enter that
   1688  fea7		       04		      LSRD		;  routine and format the last two digita without allowing
   1689  fea8		       04		      LSRD		;  the first digit to be blanked
   1690  fea9		       04		      LSRD
   1691  feaa		       37		      PSHB
   1692  feab		       16		      TAB
   1693  feac		       20 96		      BRA	END_TWO	; Now jump into the two digit formatter
   1694  feae
   1695  feae							;; PAGE 44
   1696  feae
   1697  feae							; Subroutine to display a two digit hex value
   1698  feae		       17	   DISP_HEX   TBA		; Make a duplicate copy of the value to be displayed
   1699  feaf		       54		      LSRB		; Isolate the top four bits of the copy in B
   1700  feb0		       54		      LSRB
   1701  feb1		       54		      LSRB
   1702  feb2		       54		      LSRB
   1703  feb3		       ce fe c3 	      LDX	#DIGIT_TAB	; Point to the lookup table of both decimal and hex
   1704  feb6		       3a		      ABX		;  bit patterns and index into it
   1705  feb7		       16		      TAB		; Copy the original value back into B
   1706  feb8		       a6 00		      LDAA	0,X	; Get the pattern for the first digit in A
   1707  feba		       c4 0f		      ANDB	#$0F	; Isolate the bottom four bits this time
   1708  febc		       ce fe c3 	      LDX	#DIGIT_TAB	; Again index into the table
   1709  febf		       3a		      ABX
   1710  fec0		       e6 00		      LDAB	0,X	; Now we have the bit apttern for the second digit
   1711  fec2		       39		      RTS		; Return with both digit patterns in registers
   1712  fec3
   1713  fec3							;; PAGE 45
   1714  fec3
   1715  fec3							; Lookup table of bit patterns for each digit
   1716  fec3		       fc 28 e6 ae*DIGIT_TAB  DC	ZERO, ONE, TWO, THREE, FOUR
   1717  fec8		       9e de 2c fe*	      DC	FIVE, SIX, SEVEN, EIGHT, NINE
   1718  fecd		       7e da d4 ea*	      DC	A,B,C,D,E,F
