    809  fa3d							;  to the current time
    810  fa3d		       97 a1		      STAA	TODAY_MIN1+2
    811  fa3f		       97 aa		      STAA	TODAY_MAX1+2
    812  fa41		       97 a4		      STAA	TODAY_MIN2+2
    813  fa43		       97 ad		      STAA	TODAY_MAX2+2
    814  fa45		       97 a7		      STAA	TODAY_MIN3+2
    815  fa47		       97 b0		      STAA	TODAY_MAX3+2
    816  fa49		       4f		      CLRA		; Initialize the highest byte of each sum to zero
    817  fa4a		       97 cc		      STAA	TODAY_MEAN1
    818  fa4c		       97 cf		      STAA	TODAY_MEAN2
    819  fa4e		       97 d2		      STAA	TODAY_MEAN3
    820  fa50		       4c		      INCA		; Set the number of values that have been summed so far this
    821  fa51		       97 9e		      STAA	MEAN_COUNT	;  to one
