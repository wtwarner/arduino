   1720  fed3							;; PAGE 46
   1721  fed3
   1722  fed3							; Restart and initialization
   1723  fed3
   1724  fed3							; When power is first turned on and the processor starts running
   1725  fed3							; there are cetain things which must be done before the instrument
   1726  fed3							; can be allowed to operate normally.	This incluides setting up the
   1727  fed3							; hardware to the desired mode of operation, initializing the
   1728  fed3							; contents of memory to a konwn state, performing certain tests on
   1729  fed3							; the hardware, allowing the A/D circuitry to settle and putting
   1730  fed3							; meaningful values in for the minimum, maximum, and mean
   1731  fed3							; temperatures
   1732  fed3
   1733  fed3		       fe d3	   RESTART    EQU	*	; The pointer in the vector table causes executeion to
   1734  fed3							;  begin at this point after a reset
   1735  fed3		       4f		      CLRA		; Begin by setting up the internal hardware
   1736  fed4		       97 00		      STAA	$00	; Make all 8 bits of port1 into inputs
   1737  fed6		       43		      COMA
   1738  fed7		       97 04		      STAA	$04	; Make all 16 bits of ports 3 and 4 into outputs
   1739  fed9		       97 05		      STAA	$05
   1740  fedb		       97 10		      STAA	SER_MODE_REG	; Set the serial port up for external clock
   1741  fedd		       86 12		      LDAA	#$12	; Make some of the bits in port 2 inputs and some outputs
   1742  fedf		       97 01		      STAA	$01	; Bits 0, 2, and 3 are inputs, bits 1 and 4 are outputs
   1743  fee1		       86 08		      LDAA	#TIMER_EOCI	; Set the bit to allow output compare interrupts
   1744  fee3		       97 08		      STAA	TIMER_CONTROL
   1745  fee5
   1746  fee5		       ce 00 80 	      LDX	#$80	; Initialize the contents of all 128 bytes of internal RAM
   1747  fee8		       6f 7f	   CLEAR_RAM  CLR	$7F,X	;  to zero
   1748  feea		       09		      DEX
   1749  feeb		       26 fb		      BNE	CLEAR_RAM
   1750  feed		       86 2a		      LDAA	#2026-1984	; Set the year to 2026
   1751  feef		       97 9b		      STAA	YEAR
   1752  fef1		       86 01		      LDAA	#1	; Set the month to 1
   1753  fef3		       97 c8		      STAA	MONTH
   1754  fef5		       97 8c		      STAA	A_D_SELECT	; Also set the A/D converter to select channel 1
   1755  fef7		       4c		      INCA		; Set the day to 2
   1756  fef8		       97 c5		      STAA	DAY
   1757  fefa		       86 06		      LDAA	#$06	; Set the alternate display mode selection value to
   1758  fefc		       97 cb		      STAA	ALT_SELECT	;  select all F and time
   1759  fefe		       cc ff ff 	      LDD	#$FFFF	; Finally, initialize the display memory to turn on all
   1760  ff01		       dd 85		      STD	MSD	;  eight segments of all six digits for the first few
   1761  ff03		       dd 87		      STD	MSD+2	; seconds as a means of testing all of that hardware
   1762  ff05		       dd 89		      STD	MSD+4
   1763  ff07
   1764  ff07		       8e 00 ff 	      LDS	#$FF	; Initialize the stack pointer to point at the very last
   1765  ff0a							;  RAM location - the stack will occupy the section
   1766  ff0a							;  from here down to hopefully just short of the
   1767  ff0a							;  last RAM location used for other purposes
   1768  ff0a
   1769  ff0a		       0e		      CLI		; Here we Go!!!
   1770  ff0b							; Since the only interrupt enabled in the system is the
   1771  ff0b							;  output compare interrupt, as soon as the main interrupt
   1772  ff0b							;  enable bit is cleared (it is actually an interrupt
   1773  ff0b							;  inhibit) we can begin to get output compare interrupts
   1774  ff0b
   1775  ff0b							;; PAGE 47
   1776  ff0b
   1777  ff0b							; Wait several seconds while things settle down
   1778  ff0b		       cc 03 28 	      LDD	#$300+40	; Load register A with a 3 and register B with a 40
   1779  ff0e							; The 3 will be used to communicate with the foreground
   1780  ff0e							;  task and the 40 will allow us to delay for two
   1781  ff0e							;  seconds (40 twentieths)
   1782  ff0e		       7d 00 8b    WAIT_ZERO  TST	ADC_STATE	; Each time a twentieth of a second has elapsed, this
   1783  ff11		       26 fb		      BNE	WAIT_ZERO	;  state counter will be decremented to zero - until then
   1784  ff13							;  just remain in this loop waiting
   1785  ff13		       97 8b		      STAA	ADC_STATE	; The background task must now complete a handshake
   1786  ff15							;  with the foreground task to let it know that it has
   1787  ff15							;  seen the indication of the completion of a twentieth
   1788  ff15							;  of a second and is ready to go on the the next twentieth
   1789  ff15		       5a		      DECB		; After the end of each twentieth, decrement the counter in
   1790  ff16		       26 f6		      BNE	WAIT_ZERO	;  register B to see if two seconds have passed yet
   1791  ff18
   1792  ff18							;; PAGE 48
   1793  ff18							; Now that the adc has been running for a few seconds, all of the
   1794  ff18							; voltage levels should have settled down and the individual
   1795  ff18							; measurements should all be valid, but since the value which is saved
   1796  ff18							; internally is a running average of a large number of
   1797  ff18							; measurements it could take a long time before this filtered value
   1798  ff18							; is reasonably close to the actual answer. To avoid this, it is
   1799  ff18							; necessary that we initialize the five filtered values to something
   1800  ff18							; appropriate. The way we do that is to reset the filtered value
   1801  ff18							; to zero, take one more measurement on each of the five channels,
   1802  ff18							; which will result in a filtered value which is one fourth
   1803  ff18							; of this single reading, then multiply this value by four
   1804  ff18							; and put it back
   1805  ff18
   1806  ff18		       ce 00 0e 	      LDX	#14	; The conversion buffer is 15 bytes long, but skip year (offset 14)
   1807  ff1b		       6f 8c	   CLEAR_BUF  CLR	CONV_BUF-1,X	; clear the buffer starting with the last byte
   1808  ff1d		       09		      DEX		; Decrement the combined counter and pointer
   1809  ff1e		       26 fb		      BNE	CLEAR_BUF	; Repeat until all 15 bytes are zero
   1810  ff20
   1811  ff20							; Note that because of the synchronization we achieved above with
   1812  ff20							; the foreground task there is no danger of not finishing the
   1813  ff20							; clearing of the buffer before the completion of the next
   1814  ff20							; measurement.
   1815  ff20
   1816  ff20		       c6 05		      LDAB	#5	; Set up register B as a counter to count out five more
   1817  ff22							;  conversions - register A still contains a three
   1818  ff22		       7d 00 8b    LOOP_TST   TST	ADC_STATE	; Once again, wait for foreground to complete a
   1819  ff25		       26 fb		      BNE	LOOP_TST	;  twentieth of a second
   1820  ff27		       97 8b		      STAA	ADC_STATE	; Complete the handshake
   1821  ff29		       5a		      DECB		; Do this five times
   1822  ff2a		       26 f6		      BNE	LOOP_TST
   1823  ff2c
   1824  ff2c		       ce 00 0f 	      LDX	#15	; Use X as a combined counter and pointer while multiplying
   1825  ff2f							;  each of the values in the buffer by 4
   1826  ff2f		       ec 8a	   INIT_CONV_BUF LDD	CONV_BUF-3,X	; Get a value from the buffer
   1827  ff31		       05		      LSLD		; Shift it left two bits
   1828  ff32		       05		      LSLD
   1829  ff33		       ed 8a		      STD	CONV_BUF-3,X	; The last two bits will all be zero, but their
   1830  ff35							;  significance is very small
   1831  ff35		       09		      DEX		; Back up to the previous location in the buffer
   1832  ff36		       09		      DEX
   1833  ff37		       09		      DEX
   1834  ff38		       26 f5		      BNE	INIT_CONV_BUF	; Repeat until all five filtered values have been
   1835  ff3a							;  initialized
   1836  ff3a							;; PAGE 49
   1837  ff3a
   1838  ff3a							; The final initialization task to be performed is setting the
   1839  ff3a							; contents of the various minimum, maximum, and mean values
   1840  ff3a		       bd fa 23 	      JSR	INIT_MINMAX	; Initialize today's minimum, maximum, and mean
   1841  ff3d							;  values and set the mean value counter to 1
   1842  ff3d		       ce 00 12 	      LDX	#3*3*2	; Arbitrarly set yesterdays min and
   1843  ff40							;  max to the same value
   1844  ff40		       a6 9e	   INIT_LAST  LDAA	TODAY_MIN1-1,X
   1845  ff42		       a7 b0		      STAA	LAST_MIN1-1,X
   1846  ff44		       09		      DEX
   1847  ff45		       26 f9		      BNE	INIT_LAST
   1848  ff47		       dc 9f		      LDD	TODAY_MIN1	; Also set yesterday's average to this value
   1849  ff49		       dd c3		      STD	LAST_MEAN1
   1850  ff4b		       dc a2		      LDD	TODAY_MIN2
   1851  ff4d		       dd c6		      STD	LAST_MEAN2
   1852  ff4f		       dc a5		      LDD	TODAY_MIN3
   1853  ff51		       dd c9		      STD	LAST_MEAN3
   1854  ff53
   1855  ff53							; This completes the initialization process - all that remains is
   1856  ff53							; to begin executing the normal background routines
   1857  ff53		       7e fa 54 	      JMP	DISPLAY_MODE	; Come up in normal display mode
   1858  ff56
