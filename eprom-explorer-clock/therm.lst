   1264  fc41		       ca 80		      ORAB	#$80	; Display its real value, with MSB set
   1265  fc43		       37		      PSHB		; Save the address for later
   1266  fc44		       bd fe a8 	      JSR	DISP_HEX	; Format it as two digit hex
   1267  fc47		       dd 85		      STD	MSD	; Write it directly to the display buffer
   1268  fc49		       33		      PULB		; Get the address again
   1269  fc4a		       ce 00 00 	      LDX	#0	; This time use it to fetch the contents
   1270  fc4d		       3a		      ABX		; Form the complet address in X
