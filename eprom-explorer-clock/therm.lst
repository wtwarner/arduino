    618  f985		       80 07	   DEDUCT_7   SUBA	#7	; Subtract one week from the day count
    619  f987		       22 fc		      BHI	DEDUCT_7	; Do this over and over until the count goes negative
    620  f989							;  or to zero (it will only go to zero for a Sunday)
