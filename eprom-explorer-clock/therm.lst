   1689  fea8
   1690  fea8							; Subroutine to display a two digit hex value
   1691  fea8		       17	   DISP_HEX   TBA		; Make a duplicate copy of the value to be displayed
   1692  fea9		       54		      LSRB		; Isolate the top four bits of the copy in B
   1693  feaa		       54		      LSRB
   1694  feab		       54		      LSRB
   1695  feac		       54		      LSRB
   1696  fead		       ce fe bd 	      LDX	#DIGIT_TAB	; Point to the lookup table of both decimal and hex
   1697  feb0		       3a		      ABX		;  bit patterns and index into it
   1698  feb1		       16		      TAB		; Copy the original value back into B
   1699  feb2		       a6 00		      LDAA	0,X	; Get the pattern for the first digit in A
   1700  feb4		       c4 0f		      ANDB	#$0F	; Isolate the bottom four bits this time
   1701  feb6		       ce fe bd 	      LDX	#DIGIT_TAB	; Again index into the table
