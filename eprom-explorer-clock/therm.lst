    528  f902		       dd cd		      STD	TODAY_MEAN1+1	; Return the updated second and third bytes
    529  f904		       24 03		      BCC	NO_CARRY1	; If there was a carry generated by this addition then
    530  f906		       7c 00 cc 	      INC	TODAY_MEAN1	;  increment the first byte
    531  f909
    532  f909		       dc d0	   NO_CARRY1  LDD	TODAY_MEAN2+1	; Repeat the process for zone 2
    533  f90b		       d3 90		      ADDD	CONV_BUF+3
    534  f90d		       dd d0		      STD	TODAY_MEAN2+1
    535  f90f		       24 03		      BCC	NO_CARRY2
    536  f911		       7c 00 cf 	      INC	TODAY_MEAN2
    537  f914
    538  f914		       dc d3	   NO_CARRY2  LDD	TODAY_MEAN3+1	; And for zone 3
    539  f916		       d3 93		      ADDD	CONV_BUF+6
    540  f918		       dd d3		      STD	TODAY_MEAN3+1
