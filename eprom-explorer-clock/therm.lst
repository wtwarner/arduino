   1714  fecd
   1715  fecd							; Restart and initialization
   1716  fecd
   1717  fecd							; When power is first turned on and the processor starts running
   1718  fecd							; there are cetain things which must be done before the instrument
   1719  fecd							; can be allowed to operate normally.	This incluides setting up the
   1720  fecd							; hardware to the desired mode of operation, initializing the
   1721  fecd							; contents of memory to a konwn state, performing certain tests on
   1722  fecd							; the hardware, allowing the A/D circuitry to settle and putting
   1723  fecd							; meaningful values in for the minimum, maximum, and mean
   1724  fecd							; temperatures
   1725  fecd
   1726  fecd		       fe cd	   RESTART    EQU	*	; The pointer in the vector table causes executeion to
   1727  fecd							;  begin at this point after a reset
   1728  fecd		       4f		      CLRA		; Begin by setting up the internal hardware
   1729  fece		       97 00		      STAA	$00	; Make all 8 bits of port1 into inputs
   1730  fed0		       43		      COMA
   1731  fed1		       97 04		      STAA	$04	; Make all 16 bits of ports 3 and 4 into outputs
   1732  fed3		       97 05		      STAA	$05
   1733  fed5		       97 10		      STAA	SER_MODE_REG	; Set the serial port up for external clock
   1734  fed7		       86 12		      LDAA	#$12	; Make some of the bits in port 2 inputs and some outputs
   1735  fed9		       97 01		      STAA	$01	; Bits 0, 2, and 3 are inputs, bits 1 and 4 are outputs
   1736  fedb		       86 08		      LDAA	#TIMER_EOCI	; Set the bit to allow output compare interrupts
   1737  fedd		       97 08		      STAA	TIMER_CONTROL
   1738  fedf
   1739  fedf		       ce 00 80 	      LDX	#$80	; Initialize the contents of all 128 bytes of internal RAM
   1740  fee2		       6f 7f	   CLEAR_RAM  CLR	$7F,X	;  to zero
   1741  fee4		       09		      DEX
   1742  fee5		       26 fb		      BNE	CLEAR_RAM
   1743  fee7		       86 01		      LDAA	#1	; Set the month to 1
   1744  fee9		       97 c8		      STAA	MONTH
   1745  feeb		       97 8c		      STAA	A_D_SELECT	; Also set the A/D converter to select channel 1
   1746  feed		       4c		      INCA		; Set the day to 2
   1747  feee		       97 c5		      STAA	DAY
   1748  fef0		       86 0f		      LDAA	#$0F	; Set the alternate display mode selection value to
   1749  fef2		       97 cb		      STAA	ALT_SELECT	;  select all four display modes
   1750  fef4		       cc ff ff 	      LDD	#$FFFF	; Finally, initialize the display memory to turn on all
   1751  fef7		       dd 85		      STD	MSD	;  eight segments of all six digits for the first few
   1752  fef9		       dd 87		      STD	MSD+2	; seconds as a means of testing all of that hardware
   1753  fefb		       dd 89		      STD	MSD+4
   1754  fefd
   1755  fefd		       8e 00 ff 	      LDS	#$FF	; Initialize the stack pointer to point at the very last
   1756  ff00							;  RAM location - the stack will occupy the section
   1757  ff00							;  from here down to hopefully just short of the
   1758  ff00							;  last RAM location used for other purposes
   1759  ff00
   1760  ff00		       0e		      CLI		; Here we Go!!!
   1761  ff01							; Since the only interrupt enabled in the system is the
   1762  ff01							;  output compare interrupt, as soon as the main interrupt
   1763  ff01							;  enable bit is cleared (it is actually an interrupt
   1764  ff01							;  inhibit) we can begin to get output compare interrupts
   1765  ff01
   1766  ff01							;; PAGE 47
   1767  ff01
   1768  ff01							; Wait several seconds while things settle down
   1769  ff01		       cc 03 28 	      LDD	#$300+40	; Load register A with a 3 and register B with a 40
   1770  ff04							; The 3 will be used to communicate with the foreground
   1771  ff04							;  task and the 40 will allow us to delay for two
   1772  ff04							;  seconds (40 twentieths)
   1773  ff04		       7d 00 8b    WAIT_ZERO  TST	ADC_STATE	; Each time a twentieth of a second has elapsed, this
   1774  ff07		       26 fb		      BNE	WAIT_ZERO	;  state counter will be decremented to zero - until then
   1775  ff09							;  just remain in this loop waiting
   1776  ff09		       97 8b		      STAA	ADC_STATE	; The background task must now complete a handshake
   1777  ff0b							;  with the foreground task to let it know that it has
   1778  ff0b							;  seen the indication of the completion of a twentieth
   1779  ff0b							;  of a second and is ready to go on the the next twentieth
   1780  ff0b		       5a		      DECB		; After the end of each twentieth, decrement the counter in
   1781  ff0c		       26 f6		      BNE	WAIT_ZERO	;  register B to see if two seconds have passed yet
   1782  ff0e
   1783  ff0e							;; PAGE 48
   1784  ff0e							; Now that the adc has been running for a few seconds, all of the
   1785  ff0e							; voltage levels should have settled down and the individual
   1786  ff0e							; measurements should all be valid, but since the value which is saved
   1787  ff0e							; internally is a running average of a large number of
   1788  ff0e							; measurements it could take a long time before this filtered value
   1789  ff0e							; is reasonably close to the actual answer. To avoid this, it is
   1790  ff0e							; necessary that we initialize the five filtered values to something
   1791  ff0e							; appropriate. The way we do that is to reset the filtered value
   1792  ff0e							; to zero, take one more measurement on each of the five channels,
   1793  ff0e							; which will result in a filtered value which is one fourth
   1794  ff0e							; of this single reading, then multiply this value by four
   1795  ff0e							; and put it back
   1796  ff0e
   1797  ff0e		       ce 00 0f 	      LDX	#15	; The conversion buffer is 15 bytes long
   1798  ff11		       6f 8c	   CLEAR_BUF  CLR	CONV_BUF-1,X	; clear the buffer starting with the last byte
   1799  ff13		       09		      DEX		; Decrement the combined counter and pointer
   1800  ff14		       26 fb		      BNE	CLEAR_BUF	; Repeat until all 15 bytes are zero
   1801  ff16
   1802  ff16							; Note that because of the synchronization we achieved above with
   1803  ff16							; the foreground task there is no danger of not finishing the
   1804  ff16							; clearing of the buffer before the completion of the next
   1805  ff16							; measurement.
   1806  ff16
   1807  ff16		       c6 05		      LDAB	#5	; Set up register B as a counter to count out five more
   1808  ff18							;  conversions - register A still contains a three
   1809  ff18		       7d 00 8b    LOOP_TST   TST	ADC_STATE	; Once again, wait for foreground to complete a
   1810  ff1b		       26 fb		      BNE	LOOP_TST	;  twentieth of a second
   1811  ff1d		       97 8b		      STAA	ADC_STATE	; Complete the handshake
   1812  ff1f		       5a		      DECB		; Do this five times
   1813  ff20		       26 f6		      BNE	LOOP_TST
   1814  ff22
   1815  ff22		       ce 00 0f 	      LDX	#15	; Use X as a combined counter and pointer while multiplying
   1816  ff25							;  each of the values in the buffer by 4
   1817  ff25		       ec 8a	   INIT_CONV_BUF LDD	CONV_BUF-3,X	; Get a value from the buffer
   1818  ff27		       05		      LSLD		; Shift it left two bits
   1819  ff28		       05		      LSLD
   1820  ff29		       ed 8a		      STD	CONV_BUF-3,X	; The last two bits will all be zero, but their
   1821  ff2b							;  significance is very small
   1822  ff2b		       09		      DEX		; Back up to the previous location in the buffer
   1823  ff2c		       09		      DEX
   1824  ff2d		       09		      DEX
   1825  ff2e		       26 f5		      BNE	INIT_CONV_BUF	; Repeat until all five filtered values have been
   1826  ff30							;  initialized
   1827  ff30							;; PAGE 49
   1828  ff30
   1829  ff30							; The final initialization task to be performed is setting the
   1830  ff30							; contents of the various minimum, maximum, and mean values
   1831  ff30		       bd fa 1d 	      JSR	INIT_MINMAX	; Initialize today's minimum, maximum, and mean
   1832  ff33							;  values and set the mean value counter to 1
   1833  ff33		       ce 00 12 	      LDX	#3*3*2	; Arbitrarly set yesterdays min and
   1834  ff36							;  max to the same value
   1835  ff36		       a6 9e	   INIT_LAST  LDAA	TODAY_MIN1-1,X
   1836  ff38		       a7 b0		      STAA	LAST_MIN1-1,X
   1837  ff3a		       09		      DEX
   1838  ff3b		       26 f9		      BNE	INIT_LAST
   1839  ff3d		       dc 9f		      LDD	TODAY_MIN1	; Also set yesterday's average to this value
   1840  ff3f		       dd c3		      STD	LAST_MEAN1
   1841  ff41		       dc a2		      LDD	TODAY_MIN2
   1842  ff43		       dd c6		      STD	LAST_MEAN2
   1843  ff45		       dc a5		      LDD	TODAY_MIN3
   1844  ff47		       dd c9		      STD	LAST_MEAN3
   1845  ff49
