   1220  fc12							;; PAGE 32 BACKGROUND ROUTINE
   1221  fc12
   1222  fc12							; Main background routine
   1223  fc12							; At present this routine performs three functions: it formats
   1224  fc12							; information to be displayed, using a select code passed to it in
   1225  fc12							; the A and B registers; it waits for 1/20 second to elapse and
   1226  fc12							; completes a handshake with the foreground routine; and it reads
   1227  fc12							; the keyboard and decides which keys have just been pressed.	As
   1228  fc12							; long as no more than one key is pressed at a time, it the returns
   1229  fc12							; with this keyboard information to the same routine which had
   1230  fc12							; called it, but as soon as two keys are pressed simultaneiously it
   1231  fc12							; discards the return address and goes instead to one of three
   1232  fc12							; special routines
   1233  fc12
   1234  fc12		       fc 12	   BACKGROUND EQU	*
   1235  fc12		       4d		      TSTA		; First, see if the display mode is one of the special ones
   1236  fc13		       2a 48		      BPL	NOT_SPECIAL	; If the MSB is not set then standard display mode
   1237  fc15		       48		      LSLA		; IF the MSB is set then test the next bit as well
   1238  fc16		       2a 0c		      BPL	NOT_CONST	; if this bit is set then one of the constant patterns
   1239  fc18							;  is to be displayed
   1240  fc18		       cc ff ff 	      LDD	#$FFFF	; Presently the only constant pattern is the one with
   1241  fc1b		       dd 85		      STD	MSD	;  all segments and lights on
   1242  fc1d		       dd 87		      STD	MSD+2
   1243  fc1f		       dd 89		      STD	MSD+4
   1244  fc21		       7e fd 7e 	      JMP	END_DISP	; Skip the digit blanking and copying from the temporary
   1245  fc24							;  buffer
   1246  fc24
   1247  fc24							;; PAGE 33
   1248  fc24		       48	   NOT_CONST  LSLA		; If the information to be displayed is not constant,
   1249  fc25		       2a 18		      BPL	NOT_DISP_ALT	;  see if it is alternate select mode
   1250  fc27		       cc d4 56 	      LDD	#C*$100+F	; If it is then display the characters 'CFHd'
   1251  fc2a		       dd dd		      STD	TEMP_BUF
   1252  fc2c		       cc 7a ea 	      LDD	#H*$100+D
   1253  fc2f		       dd df		      STD	TEMP_BUF+2
   1254  fc31		       cc 60 f8 	      LDD	#SET+DEGC+DEGF+AM+PM+DATE+CURR	; Turn on all these indicator lights
