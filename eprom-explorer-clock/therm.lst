    375  f86d
    376  f86d							; A/D conversion state 0
    377  f86d		       f8 6d	   STATE_0    EQU	*
    378  f86d		       dc 0b		      LDD	TIMER_OCR_REG	; Note the time at which the discharge will begin
    379  f86f		       dd 9c		      STD	START_TIME	; Save it to use in the calculations for this conversion
    380  f871		       86 0f		      LDAA	#7+ACC3	; To start the discharge, select channel 7 of the
    381  f873							;  multiplexer and also set the bit which enables the compartor
    382  f873		       20 f0		      BRA	SET_MUX	; Use the section of code above to write this value out
    383  f875							;  to the multiplexer channel select latch and also to prepare
    384  f875							;  the output compare pin for a positive transition on the next
    385  f875							;  interrupt
    386  f875							; A/D conversion state 2
    387  f875		       f8 75	   STATE_2    EQU	*	; This routine is not required to perform any A/D
    388  f875							;  related functions, but it does perform every periodic
    389  f875							;  function whose period is longer than 1/20 second as well as
    390  f875							;  maintaining synchronization with the line
    391  f875
    392  f875							;; Line synchronization function
    393  f875
    394  f875							; There are two basic purposes to this section: first, it maintains
    395  f875							; correct synchronization with the ac line at all times. To do
    396  f875							; this, it checks once during each conversion to see whether then
    397  f875							; internal timing has shifted by more than plus or minus 60 degrees
    398  f875							; with respect to the ac line. If it has then the internal timing
    399  f875							; is shifted slightly, making that measurement cycle slightly longer
    400  f875							; or slightly shorter than nominal to try to bring the timing back
    401  f875							; within the plus or minus 60 degree phase window. If there has been
    402  f875							; a large phase shift then it might take several shortened or
    403  f875							; lengthened cycles to get back to within the window.	As soon as they
    404  f875							; are back in phase, normal length cycles are resumed. The second
    405  f875							; function is more subtle. It is also activated by phase shifts of
    406  f875							; more than 60 degrees, but in this case the effect is to make very
    407  f875							; small but permanent changes in the normal lengt of a cycle.	This
    408  f875							; type of change would not be necessary if the ac line signal were
    409  f875							; always going to be present to maintian synchronization, but since
    410  f875							; the instrument can have a battery backup, and since better accuracy
    411  f875							; than just the nominal crystal frequency accuracy is desirable, the
    412  f875							; software is, in effect, gradually forming a correction to the
    413  f875							; crystal frequency, based on line frequency, which will then be
    414  f875							; used while the ac power is off.
    415  f875
    416  f875		       96 83		      LDAA	TIME_CORRECT+1	; Since the period of a conversion is 50,000
    417  f877							;  instruction cycles, if the correction were an integer value in
    418  f877							;  cycles, the best correction that could be made is plus or minus
    419  f877							;  1/50,000 which is nearly two seconds per day of error - to get
    420  f877							;  around this, a one byte fractional correction is maintained.
    421  f877		       9b 8f		      ADDA	TIME_RESIDUAL	; To use this correction, it is added each time to
    422  f879							;  a one byte residual value, and each time there is a carry
    423  f879							;  from this byte, one more full instruction cycle is added
    424  f879							;  to this time
    425  f879		       97 8f		      STAA	TIME_RESIDUAL	; Save the new residual
    426  f87b		       dc 0b		      LDD	TIMER_OCR_REG	; Take the previously calculated time of the next
    427  f87d							;  interrupt
    428  f87d							;; PAGE 11
    429  f87d		       d9 82		      ADCB	TIME_CORRECT	; Add in the upper byte of the correction value
    430  f87f		       89 00		      ADCA	#0	; Handle any carry to the top byte of the interrupt time
    431  f881		       7d 00 82 	      TST	TIME_CORRECT	; See whether the correction was intended to be
    432  f884							;  positive or negative
    433  f884		       2a 01		      BPL	IS_POS	; If it is negative then
    434  f886		       4a		      DECA		; subtract one count from the top byte
    435  f887		       dd 0b	   IS_POS     STD	TIMER_OCR_REG	; Put back the corrected time of the next interrupt
    436  f889		       de 82		      LDX	TIME_CORRECT	; Get the correction value in case it whill need to
    437  f88b							;  be adjusted
    438  f88b		       96 81		      LDAA	LINE_PHASE	; See what the AC line has been doing for the last
    439  f88d							;  eight interrupts
    440  f88d		       81 1c		      CMPA	#%00011100	; Test for internal time fast by 60 degrees or more
    441  f88f		       26 04		      BNE	IS_NOT_FAST	; If it is then
    442  f891		       7a 00 0b 	      DEC	TIMER_OCR_REG	;  shorten this conversion
    443  f894		       09		      DEX		;  and slightly shorten all subsequenty conversions
    444  f895		       81 e3	   IS_NOT_FAST CMPA	#%11100011	; Else test for internal time slow
    445  f897		       26 04		      BNE	IS_NOT_SLOW	; If it is then
    446  f899		       7c 00 0b 	      INC	TIMER_OCR_REG	;  lengthen this conversion
    447  f89c		       08		      INX		;  and slightly length all subsequent conversions
    448  f89d		       df 82	   IS_NOT_SLOW STX	TIME_CORRECT	; Put back the (possibly) modified correction
    449  f89f
    450  f89f							;; PAGE 12
    451  f89f
    452  f89f							; The final operation to be performed at 20 Hz is decrementing a
    453  f89f							; counter which is used to time 6 second intervals, because the
    454  f89f							; next groups of functions is performed ten times each minute
    455  f89f		       7a 00 92 	      DEC	TWENTIETHS	; This variable counts twentieths of a second
    456  f8a2		       26 59		      BNE	IRET	; If six seconds have not elapsed yet then just return
    457  f8a4		       86 78		      LDAA	#120	; Else restart the counter at six seconds
    458  f8a6		       97 92		      STAA	TWENTIETHS
    459  f8a8		       96 95		      LDAA	TENTHS	; The next counter is used to count tenths of a minute.
    460  f8aa		       8b 01		      ADDA	#1	;  In BCD, up to 99 tenths
    461  f8ac		       19		      DAA		; Since this is a BCD counter, adjust it to a decimal value each
    462  f8ad		       97 95		      STAA	TENTHS	;  time it is incremented
    463  f8af		       27 4d		      BEQ	TEN_MINUTES	; If ten minutes has elapsed then perform those
    464  f8b1							;  functions which are done every ten minutes.
    465  f8b1
    466  f8b1							;; PAGE 13
    467  f8b1
    468  f8b1							; The next function is performed 99 times every ten minutes.  It is
    469  f8b1							; not done the hundredth time because there is a lot more to be
    470  f8b1							; done that time and it would make the processor loading much higher
    471  f8b1							; to do both. the function of this section of code is to update the
    472  f8b1							; minimum and maximum values of each of the three zone temperatures.
    473  f8b1							; The mean values are updated at ten minute intervals.
    474  f8b1		       96 98		      LDAA	TIME_OF_DAY	; Load the current time into register A in case we
    475  f8b3							;  need to note the time at which a new min or max was reached
    476  f8b3		       de 8d		      LDX	CONV_BUF	; Load the current temperature of zone 1
    477  f8b5		       9c a8		      CPX	TODAY_MAX1	; see if it is a new daily maximum
    478  f8b7		       24 04		      BHS	IS_HIGHER1	; Since the conversion value varies inversely with the
    479  f8b9							;  temperature, the sense of the test looks backward
    480  f8b9		       df a8		      STX	TODAY_MAX1	; If the current temp ois higher than the previous
    481  f8bb							;  daily maximum then replace the old maximum with the current
    482  f8bb		       97 aa		      STAA	TODAY_MAX1+2	; The third byte of this value is the time of day
    483  f8bd							;  at which the maximum occured, in tens of minutes.
    484  f8bd		       9c 9f	   IS_HIGHER1 CPX	TODAY_MIN1	; If no new maximum then see if new minimum
    485  f8bf		       23 04		      BLS	IS_LOWER1	; Again, skip the next 2 instructions if no new min
    486  f8c1		       df 9f		      STX	TODAY_MIN1
    487  f8c3		       97 a1		      STAA	TODAY_MIN1+2
    488  f8c5		       de 90	   IS_LOWER1  LDX	CONV_BUF+3	; Do the same for zone 2
    489  f8c7		       9c ab		      CPX	TODAY_MAX2
    490  f8c9		       24 04		      BHS	IS_HIGHER2
    491  f8cb		       df ab		      STX	TODAY_MAX2
    492  f8cd		       97 ad		      STAA	TODAY_MAX2+2
    493  f8cf		       9c a2	   IS_HIGHER2 CPX	TODAY_MIN2
    494  f8d1		       23 04		      BLS	IS_LOWER2
    495  f8d3		       df a2		      STX	TODAY_MIN2
    496  f8d5		       97 a4		      STAA	TODAY_MIN2+2
    497  f8d7		       de 93	   IS_LOWER2  LDX	CONV_BUF+6	; And for zone 3
    498  f8d9		       9c ae		      CPX	TODAY_MAX3
    499  f8db		       24 04		      BHS	IS_HIGHER3
    500  f8dd		       df ae		      STX	TODAY_MAX3
    501  f8df		       97 b0		      STAA	TODAY_MAX3+2
    502  f8e1		       9c a5	   IS_HIGHER3 CPX	TODAY_MIN3
    503  f8e3		       23 04		      BLS	IS_LOWER3
    504  f8e5		       df a5		      STX	TODAY_MIN3
    505  f8e7		       97 a7		      STAA	TODAY_MIN3+2
    506  f8e9		       7f 00 d8    IS_LOWER3  CLR	ALARM	; Calculate the new alarm bits, first clearing out the old
    507  f8ec		       dc 99		      LDD	CONV_BUF+12	; See if zone 3 is higher than the high reference
    508  f8ee		       93 93		      SUBD	CONV_BUF+6
    509  f8f0		       79 00 d8 	      ROL	ALARM	; If it is then set the low temp alarm bit (high to turn on)
    510  f8f3		       dc 93		      LDD	CONV_BUF+6	; See if zone 3 is lower than the average of the high
    511  f8f5		       05		      LSLD		;  and low references
    512  f8f6		       93 96		      SUBD	CONV_BUF+9
    513  f8f8		       93 99		      SUBD	CONV_BUF+12
    514  f8fa		       79 00 d8 	      ROL	ALARM	; If it is then set the high temp alarm (high to turn on)
    515  f8fd		       3b	   IRET       RTI		; This completes the operations performed ten times each
    516  f8fe							;  minute
    517  f8fe							;; PAGE 14
    518  f8fe							;; Functions performed every ten minutes
    519  f8fe
    520  f8fe							; Every ten minutes the calculated value of today's mean temperature
    521  f8fe							; for each of the three zones is updated. After that, a check is made
    522  f8fe							; for two special times of the day, midnight and 2AM.
    523  f8fe
    524  f8fe		       f8 fe	   TEN_MINUTES EQU	*
    525  f8fe		       dc cd		      LDD	TODAY_MEAN1+1	; Get the second and third bytes of the running
    526  f900							;  sum of zone 1 at ten minute intervals so far today
