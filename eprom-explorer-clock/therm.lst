    632  f990
    633  f990							;; Functions performed at midnight every day
    634  f990
    635  f990							; The following operations all have to do with updating the day,
    636  f990							; month and year counters.  The day counter has a range of one to
    637  f990							; 28, 29, 30 or 31, depending on the month, but is stored as twice
    638  f990							; this value so that the least significant bit can be used as a flag
    639  f990							; to indicate that a change from daylight saving time to standard
    640  f990							; time has been made that day. The month has a value from 1 to 12
    641  f990							; (January to December) and the year has a value between 0 (1984)
    642  f990							; and 255 (2239).  All corrections for leap years are made properly
    643  f990							; over this entire time span.
    644  f990
    645  f990		       f9 90	   MIDNIGHT   EQU	*
    646  f990		       8d 43		      BSR	DAYS_IN_MONTH	; Before incrementing the day we must see how many
    647  f992							;  days there are in this month.
    648  f992							; This value will be returned in register B
    649  f992		       96 c5		      LDAA	DAY	; Now see what day of the month this is
    650  f994		       44		      LSRA		; Shift out the daylight saving flag
    651  f995		       11		      CBA		; See if we just ended the last day of a month
    652  f996		       25 14		      BLO	INC_DAY	; If not then just increment the day normally
    653  f998		       96 c8		      LDAA	MONTH	; If the month has just ended then increment the month
    654  f99a		       81 0c		      CMPA	#12	; When the month ends there is also the possibility that
    655  f99c		       25 0a		      BLO	INC_MONTH	;  the year has just ended
    656  f99e		       7c 00 9b 	      INC	YEAR	; Execute this instruction once each year at midnight on
    657  f9a1							;  December 31
    658  f9a1
    659  f9a1							;		     BEQ     *
    660  f9a1							; Wouldn't it be fun to actually put the above instruction into the
    661  f9a1							; program? I can just see it now......
    662  f9a1							; It is new years eve in the year 2239, and precisely at midnight,
    663  f9a1							; all around the world, everyone's HP clock thermometer suddenly
    664  f9a1							; goes dead! Since every copy of this listing has long since been
    665  f9a1							; lost, it will remain a mystery forever how this couild have happened.
    666  f9a1							;
    667  f9a1							; But seriously, what do we do when the last counter finally runs out?
    668  f9a1							; Do we simply set it become 1984 all over again? This would allow the
    669  f9a1							; corrections for leap year to be done properly for another 60 years
    670  f9a1							; until the year 2300. But what about the corrections for daylight
    671  f9a1							; saving time? The best soluition is to find a year between 1984 and
    672  f9a1							; 2239 which is the same as 2240 with respect to leap years and
    673  f9a1							; days of the week. As it happens, there are many years which meet
    674  f9a1							; these requirements, the earliest being 1992. Of course, the year
    675  f9a1							; will read incorrectly and it will still fail in the year 2300, but
    676  f9a1							; then you can't have everything.
    677  f9a1		       26 04		      BNE	NOT_ROLLOVER	; In any year except 2240, skip the next two instructions
    678  f9a3		       86 08		      LDAA	#1992-1984	; Reset the year to 1992
    679  f9a5		       97 9b		      STAA	YEAR
    680  f9a7		       4f	   NOT_ROLLOVER CLRA		; Reset the month to January
    681  f9a8		       4c	   INC_MONTH  INCA		; Increment the month value
    682  f9a9		       97 c8		      STAA	MONTH	; Save the incremented value
    683  f9ab		       4f		      CLRA		; Start the day counter over at day 1
    684  f9ac		       4c	   INC_DAY    INCA		; Increment the day value
    685  f9ad		       48		      LSLA		; Save it doubled form to leave room for the DST flag
    686  f9ae		       97 c5		      STAA	DAY	; Save the incremented value
    687  f9b0
    688  f9b0							;; PAGE 17  CLOCK TIMER INTERRUPT SERVICING
    689  f9b0
    690  f9b0							; The last function to be performed by the clock interrupt is
    691  f9b0							; the daily calculation of the average temperatures for that day and
    692  f9b0							; the saving of those values as the previous day's averages, followed
    693  f9b0							; by the re-initialization of today's averages and the updating of
    694  f9b0							; all of the minimum and maximum values
    695  f9b0
    696  f9b0		       ce 00 cc 	      LDX	#TODAY_MEAN1	; Point to the sum of the values for zone 1
    697  f9b3		       8d 48		      BSR	AVERAGE	; Convert this to an average value
    698  f9b5		       dd c3		      STD	LAST_MEAN1	; Save this as yesterday's average
    699  f9b7		       ce 00 cf 	      LDX	#TODAY_MEAN2	; Do the same for the other two zones
    700  f9ba		       8d 41		      BSR	AVERAGE
    701  f9bc		       dd c6		      STD	LAST_MEAN2
    702  f9be		       ce 00 d2 	      LDX	#TODAY_MEAN3
    703  f9c1		       8d 3a		      BSR	AVERAGE
    704  f9c3		       dd c9		      STD	LAST_MEAN3
    705  f9c5		       ce 00 12 	      LDX	#LAST_MIN1-TODAY_MIN1	; Now set yesterday's min and max values
    706  f9c8							;  to today's - use X as a byte counter and also a pointer
    707  f9c8		       a6 9e	   SET_LAST   LDAA	TODAY_MIN1-1,X	; Get one byte of today's data
    708  f9ca		       a7 b0		      STAA	LAST_MIN1-1,X	; Copy it into the corresponding byte of
    709  f9cc		       09		      DEX		;  yesterday's data and decrement the pointer/counter
    710  f9cd		       26 f9		      BNE	SET_LAST	; Repeat until all bytes have been copied
    711  f9cf		       7f 00 98 	      CLR	TIME_OF_DAY	; Reset the current time of day to midnight
    712  f9d2		       8d 4f		      BSR	INIT_MINMAX	; Initialize the minimu, maximum and average values
    713  f9d4		       3b	   IRQ_EXIT   RTI
    714  f9d5
    715  f9d5							;; PAGE 18 CLOCK TIMER INTERRUPT SERVICING
    716  f9d5
    717  f9d5							; Subroutine to find out how many days there are in a month
    718  f9d5		       f9 d5	   DAYS_IN_MONTH EQU	*
    719  f9d5		       d6 c8		      LDAB	MONTH	; See which month this is
    720  f9d7		       ce f9 f0 	      LDX	#MONTH_TABLE-1	; Point to a lookup table of days in a month
    721  f9da		       3a		      ABX		; Index into the lookup table
    722  f9db		       e6 00		      LDAB	0,X	; Load the value from the table
    723  f9dd		       c1 1c		      CMPB	#28	; See if this is February
    724  f9df		       26 0f		      BNE	RETURN_DAYS	; If it is not then this is the correct number of days
    725  f9e1		       96 9b		      LDAA	YEAR	; If it is then we must also see if this is a leap year
    726  f9e3		       85 03		      BITA	#ACC0+ACC1	; By looking at just the last two bits in the year we
    727  f9e5		       26 09		      BNE	RETURN_DAYS	;  know whether or not it is divisible by four
    728  f9e7		       81 74		      CMPA	#2100-1984	; If it is then we must also test for two such years
    729  f9e9		       27 05		      BEQ	RETURN_DAYS	;  which will not be leap years - 2100 and 2200
    730  f9eb		       81 d8		      CMPA	#2200-1984	; Oddly enough, the year 2000 is a leap year
    731  f9ed		       27 01		      BEQ	RETURN_DAYS	; After eliminating all non leap years over this time
    732  f9ef		       5c		      INCB		;  span, this leaves only leap years, for which February
    733  f9f0							;  has 29 days
    734  f9f0		       39	   RETURN_DAYS RTS		; Return with the number of days in the current month
    735  f9f1							;  in register B
    736  f9f1
    737  f9f1		       f9 f1	   MONTH_TABLE EQU	*	; Lookup table of days in the month
    738  f9f1		       1f		      DC	31	; January
    739  f9f2		       1c		      DC	28	; February (may be 29)
    740  f9f3		       1f		      DC	31	; March
    741  f9f4		       1e		      DC	30	; April
    742  f9f5		       1f		      DC	31	; May
    743  f9f6		       1e		      DC	30	; June
    744  f9f7		       1f		      DC	31	; July
    745  f9f8		       1f		      DC	31	; August
    746  f9f9		       1e		      DC	30	; September
    747  f9fa		       1f		      DC	31	; October
    748  f9fb		       1e		      DC	30	; November
    749  f9fc		       1f		      DC	31	; December
