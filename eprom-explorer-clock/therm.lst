    158  10000 ????				       SEG	CODE,0
    159  f800					      ORG	$F800
    160  f800
    161  f800							;;;  PAGE 4 CLOCK TIMER INTERRUPT SERVICING
    162  f800
    163  f800							; All of the software in this program can be divided into two
    164  f800							; categories - that which is executed as the result of an interrupt
    165  f800							; and that which is not. The software which is not executed under
    166  f800							; interrupt includes initialization after reset, keyboard servicing,
    167  f800							; display servicing and serial communications.  These are all basically
    168  f800							; asynchronous operations in that they are not periodic functions
    169  f800							; that are performed at fixed time intervals, although they are
    170  f800							; indirectly tied into a repetition rate of 20 times each second in
    171  f800							; order to provide sipmle debouncing of the keyboard.
    172  f800							; All other functions of this program are periodic and are performed
    173  f800							; by the timer interrupt service routine. This routine can request
    174  f800							; that a timer interrupt occur, causin the routine to be executed
    175  f800							; at whatever interval it likes, and the interval which it selects is
    176  f800							; 2.778 milliseconds. This value is essentially 1/360 second, and the
    177  f800							; reason that this inverval was chosen was to allow the display
    178  f800							; refreshing to be performed 360 times each second. In addition, it
    179  f800							; will be seen that there are other functions which are performed at
    180  f800							; less frequent intervals by this routine sipmly by executing the
    181  f800							; appropriate code every n'th time an interrupt occurs, where n is
    182  f800							; 6, 18, 2160, etc. This gives execution frequencies of 60 hz, 20 hz,
    183  f800							; 1/6 hz, once each 10 minutes, once each day, once each
    184  f800							; month and once each year.  For clarity, the software has been
    185  f800							; divided up to show which parts are executed at which intervals.
    186  f800							;
    187  f800							; One of the main functions of this routine is to operate the
    188  f800							; analog to digital converter, or A/A. each conversions consists of
    189  f800							; two simple operations. First, one of the analog input signals is
    190  f800							; used to charge up a capacitor for a fixed time period. This means
    191  f800							; that the amount of charge in the capacitor is now directly
    192  f800							; proportional to the signal voltage. Next, the capacitor is
    193  f800							; discharged at a fixed rate using a reference signal of the
    194  f800							; opposite polarity until the capacitor voltage is back to zero.
    195  f800							; The time taken to discharge the capacitor is measured and is a
    196  f800							; direct measure of the input signal.	The hardware then holds the
    197  f800							; capacitor in a discharged state until the start of the next
    198  f800							; measurement cycle.  This process is repeated every 1/20 second,
    199  f800							; with the integration of the input signal taking the first 1/60
    200  f800							; second and the discharge and wait for the next measurement taking
    201  f800							; the remaining 2/60 second.
    202  f800
    203  f800							;;;  PAGE 5 CLOCK TIMER INTERRUPT SERVICING
    204  f800
    205  f800							;;;  Begin the timer interrupt service routine
    206  f800
    207  f800		       f8 00	   TIMER_INT  EQU	*	; Arrive at this point an average of once every
    208  f800							;  1/360 second as a result of a timer interrupt
    209  f800							; The task which is most sensitive to timing, and is therefore
    210  f800							; performed first, is that of maintaining synchronization with the
    211  f800							; AC line. Once every 1/360 second the line voltage is tested to see
    212  f800							; whether it is above or below zero volts. At any time it is
    213  f800							; possible to check this information for the previous 8 interrupts,
    214  f800							; which covers a period of slightly more than one full line cycle.
    215  f800							; This infomation will be used by another part of this routine,
    216  f800							; which executes once every 1/20 second.
    217  f800
    218  f800		       d6 02		      LDAB	PORT1	; The line voltage information is read in through the
    219  f802							;  most significant bit of port 1.
    220  f802		       96 81		      LDAA	LINE_PHASE	; The value of this bit for the last eight interrupts
    221  f804							;  is contained in the variable LINE_PHASE.
    222  f804		       05		      LSLD		; This instruction throws away the oldest bit line_phase,
    223  f805							;   shifts the other seven left one place and enters the newest
    224  f805							;   bit in the least significant bit of the value
    225  f805		       97 81		      STAA	LINE_PHASE	; Save this for later interrupts and other uses
    226  f807
    227  f807							; Every time there is a timer interrupt the hardware must be told
    228  f807							; when the next interrupt is to occur. This information is written
    229  f807							; into a 16 bit hardware register called the output compare register
    230  f807							; (OCR). Since this register already contains the time at which the
    231  f807							; present interrupt was triggered, all that is necessary is to take
    232  f807							; this value and add the equivalent of 1/360 second to it, then
    233  f807							; put it back.
    234  f807		       96 08		      LDAA	TIMER_CONTROL	; Read the flag so that it will be cleared
    235  f809		       dc 0b		      LDD	TIMER_OCR_REG	; Load the 16 bit time at which this interrupt
    236  f80b		       c3 0a da 	      ADDD	#2778	;  occurred - the value 2778 is the number of instruction
    237  f80e							;  cycles, at 1,000,000 cycles each second, in 1/360 second
    238  f80e		       dd 0b		      STD	TIMER_OCR_REG	; The value 2778 is not exactly the correct value
    239  f810							;  but a further correction will be made later to compensate
    240  f810
    241  f810							; The serial port servicing, once it is written, will require a
    242  f810							; short routine to read the serial port receiver register and
    243  f810							; transfer any received character to the input buffer
    244  f810
    245  f810
    246  f810							;;; PAGE 6 CLOCK TIMER INTERRUPT SERVICING
    247  f810
    248  f810							; The only other task which occurs every 1/360 second is the
    249  f810							; refreshing of the display, at each interrupt the digit which is
    250  f810							; currently being displayed is turned off and the required segments
    251  f810							; of the next digit are turned on.
    252  f810
    253  f810		       7f 70 00 	      CLR	SEGMENT_DRIVE	; Turn off all segments before enabling the next
    254  f813							;  digit in order to avoid 'ghost' segments
    255  f813		       96 84		      LDAA	DIGIT	; The variable 'digit' has just one bit set corresponding
    256  f815							;  to the digit which is to be enabled next
    257  f815		       16		      TAB		; Make a second copy of it
    258  f816		       da d8		      ORAB	ALARM	; Add in the bits which control the two alarm outputs
    259  f818		       f7 60 00 	      STAB	DIGIT_DRIVE	; Write these bits out to the hardware
    260  f81b		       ce 00 84 	      LDX	#MSD-1	; It is now necessary to find out which segments to turn
    261  f81e							;  on for this digit - this information is contained in
    262  f81e							;  a six byte array in memory
    263  f81e		       08	   SELECT_RFSH INX		; Point to the segments of the first digit
    264  f81f		       48		      LSLA		; If that is the one to be displayed then its bit will shift out
    265  f820							;  of register A, leaving a zero
    266  f820		       26 fc		      BNE	SELECT_RFSH	; If the value in A is not yet zero then it is not
    267  f822							;  the first digit, so go back, point to the second digit
    268  f822							;  and see if it is the one to be displayed, etc.
    269  f822		       a6 00		      LDAA	0,X	; Eventually the bit which was set in register A will be
    270  f824							;  shifted out and the index register will contain the address
    271  f824							;  of the segments for this digit, so load the segment bits
    272  f824							;  themselves into register A
    273  f824		       b7 70 00 	      STAA	SEGMENT_DRIVE	; Write them out to the hardware, turning on
    274  f827							;  those segments
    275  f827		       78 00 84 	      LSL	DIGIT	; Shift the digit bit left one place so that when the next
    276  f82a							;  interrupt occurs the next digit will be displayed
    277  f82a		       27 05		      BEQ	SIXTY_HZ	; Eventually the bit will be shifted out to leave a
    278  f82c							;  value of zero - each time this occurs we go on to
    279  f82c							;  execute the 60 Hz and slower operations - the other
    280  f82c							;  five times out of six we just make sure that an
    281  f82c							;  output bit will get set to zero
    282  f82c		       86 08		      LDAA	#TIMER_EOCI	; Clear the bit that controls the level of the
    283  f82e		       97 08		      STAA	TIMER_CONTROL	;  output compare pin - this guarantees that it
    284  f830							;  will normally be low
    285  f830		       3b		      RTI		; This completes the functions which are performed 360 times
    286  f831							;  each second
    287  f831
    288  f831							;; PAGE 7 CLOCK TIMER INTERRUPT SERVICING
    289  f831
    290  f831							; Operations which are performed 60 times each second
    291  f831
    292  f831		       86 04	   SIXTY_HZ   LDAA	#ACC2	; Each time the digit bit shifts all the way out, must
    293  f833		       97 84		      STAA	DIGIT	;  reinitialize it to select last digit
    294  f835
    295  f835							; The only other 60 Hz operation is the selection of which 20 Hz
    296  f835							; operation is to be performed at this time
    297  f835		       96 8b		      LDAA	ADC_STATE	; The ADC state counter can have values 0, 1, 2
    298  f837							;  or 3, but this routine should only see values of 1, 2, or 3 at this
    299  f837							;  point
    300  f837		       4a		      DECA		; Decrement the state value to 0, 1, or 2 and save it
    301  f838		       97 8b		      STAA	ADC_STATE	; The value of 0 is used as an indicator to the
    302  f83a							;  background task that another 1/20 second has elapsed - the
    303  f83a							;  background task will then set the state value back up to 3
    304  f83a							; Now branch to one of three routines which are each executed
    305  f83a							; at 20 hz
    306  f83a		       27 31		      BEQ	STATE_0	; If the state counter is zero, execute the state zero
    307  f83c							;  routine
    308  f83c		       4a		      DECA		; Otherwise see if it is one
    309  f83d		       27 07		      BEQ	STATE_1	; Go to state one if it is
    310  f83f		       4a		      DECA		; Finally, see if we are in state 2
    311  f840		       27 33		      BEQ	STATE_2
    312  f842		       7f 00 8b 	      CLR	ADC_STATE	; If it is noe of these then there is a very serious
    313  f845		       3b		      RTI		;  problem, but see if we can recover from it by just setting
    314  f846							;  the state to a known value and returning to background
    315  f846
    316  f846							;; PAGE 8 CLOCK TIMER INTERRUPT SERVICING
    317  f846
    318  f846							; A/D servicing
    319  f846							;
    320  f846							; The three A/D service routines perform the following functions:
    321  f846							; in state one, the integration of one of the anlog signals is
    322  f846							; initiated by writing its selection code into the first latch of
    323  f846							; the A/D circuit. The output level bit is then set high so that
    324  f846							; there will be a positive transition on the next timer interrupt,
    325  f846							; which will transfer the select bits to the second latch. Before
    326  f846							; any of this is done, however, this routine finishes the previous
    327  f846							; conversion by reading in the input capture value and performing
    328  f846							; filtering on it.
    329  f846							; In state zero, the integration is terminated and discharging
    330  f846							; begins.
    331  f846							; In state two, nothing is done which involves the A/D, but in
    332  f846							; this state any periodic function which occurs less frequently
    333  f846							; than 20 Hz takes place, such as updating the clock and calendar
    334  f846							; as well as minimum, maximum and mean temperature calculations.
    335  f846							; Phase adjustment to the AC line also takes place in this routine.
    336  f846
    337  f846							; A/D converion, state 1
    338  f846		       d6 8c	   STATE_1    LDAB	A_D_SELECT	; See which signal was just measured
    339  f848		       ce 00 8a 	      LDX	#CONV_BUF-3	; Point to the buffer of filtered conversion values
    340  f84b		       3a		      ABX		; The filtered values are each three bytes apart so add the
    341  f84c		       58		      LSLB		;  channel number times three to point to the appriopriate entry
    342  f84d		       3a		      ABX		; This is the address of the filtered value for this channel
    343  f84e		       dc 0d		      LDD	TIMER_ICR_REG	; Get the time at which the conversion ended
    344  f850		       93 9c		      SUBD	START_TIME	; Subtract the time at which the discharge started
    345  f852							; This is the discharge time and is a direct measure
    346  f852							;  of the signal voltage
    347  f852		       a3 00		      SUBD	0,X	; Find the difference between this and the old filtered
    348  f854							;  value - the object here is to add back a small fraction
    349  f854							;  of this difference to the old filtered value in order
    350  f854							;  to arrive at a new filtered value - in this case we will
    351  f854							;  take 1/4 of the difference and add it back
    352  f854		       47		      ASRA		; Do an arithmetic shift right since the difference is signed
    353  f855		       56		      RORB		; Shift the second byte
    354  f856		       47		      ASRA		; Shift a second time
    355  f857		       56		      RORB
    356  f858		       e3 00		      ADDD	0,X	; Add the upper two bytes of the values
    357  f85a		       ed 00		      STD	0,X	; Save these two bytes
