   1707  febd
   1708  febd							; Lookup table of bit patterns for each digit
   1709  febd		       fc 28 e6 ae*DIGIT_TAB  DC	ZERO, ONE, TWO, THREE, FOUR
   1710  fec2		       9e de 2c fe*	      DC	FIVE, SIX, SEVEN, EIGHT, NINE
   1711  fec7		       7e da d4 ea*	      DC	A,B,C,D,E,F
