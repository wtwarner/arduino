    817  fa4e							;; PAGE 21 DISPLAY MODE ROUTINES
    818  fa4e
    819  fa4e							; Main Program
    820  fa4e							; The main program consists basically of four mode routines. The
    821  fa4e							; primary mode routine is the display routine. The one in which each
    822  fa4e							; of the pieces of information is individually displayed and selected
    823  fa4e							; by processing the three buttons.  Next there is the alternate display
    824  fa4e							; routine in which several pices of information are displayed
    825  fa4e							; alternately over a period of several seconds. Then there is the
    826  fa4e							; set mode in which setpoints are entered for several parameters,
    827  fa4e							; such as the time and date.  Finally, there is a diagnostic mode in
    828  fa4e							; which information aobut the functioning of the hardware itself
    829  fa4e							; can be displayed. To go from the display routine to any of the
    830  fa4e							; others requires that two keys be pressed simultaneously.
    831  fa4e
    832  fa4e							; DISPLAY ROUTINE
    833  fa4e
    834  fa4e		       fa 4e	   DISPLAY_MODE EQU	*	; This is the main mode of operation of this
    835  fa4e							;  instrument. It is used to display any of 68 different pieces of
    836  fa4e							;  information one at a time.	The information is selected by pressing
    837  fa4e							;  the tree front panel switches one at a time to specify three
    838  fa4e							;  identifiers of the information to be displayed. First there is
    839  fa4e							;  switch 1, which specifies whether the information is a centegrade
    840  fa4e							;  temperature, fahrenheit temperature, a time of date or a date.
    841  fa4e							;  Next, switch 2 specifies whether the information refers to
    842  fa4e							;  temperature zones 1, 2 or 3. Finally, switch 3 specifies whether
    843  fa4e							;  the information is the current value, the maximum or minimum
    844  fa4e							;  value so far today, the mean value so far today, or yesterday's
    845  fa4e							;  maximum, minimum or mean.
    846  fa4e		       dc d5		      LDD	DISP_SELECT	; Get the 2 byte value which specifies the
    847  fa50							;  information to be displayed
    848  fa50		       bd fc 12 	      JSR	BACKGROUND	; Format and display the information
    849  fa53							; This major routine does much more than just format display data
    850  fa53							;  and read the keyboard, which is the last thing it does
    851  fa53							;  before returning
    852  fa53		       44		      LSRA		; The keyboard is returned in the low 3 bits of A
    853  fa54		       25 21		      BCS	INC_SW1	; If bit 0 was set then switch 1 was just pressed
    854  fa56		       44		      LSRA		; If switch 1 was not just pressed then see if switch 2 was
    855  fa57		       25 12		      BCS	INC_SW2	; If bit 1 was set then switch 2 was just pressed
    856  fa59		       27 f3		      BEQ	DISPLAY_MODE	; If switches 1 and 2 were not pressed and bit 2
    857  fa5b							;  is also zero then none of the switches was pressed, so
    858  fa5b							;  just continue to display the same information
    859  fa5b							; If bit 2 is set then increment the switch 3 selection bits
    860  fa5b
    861  fa5b							; PAGE 22 DISPLAY MODE ROUTINES
    862  fa5b
    863  fa5b							; Increment the switch 3 selection bitts
    864  fa5b		       96 d5		      LDAA	DISP_SELECT	; This byte contains the selection bits for both
    865  fa5d							;  switch 1 and switch 3
    866  fa5d		       8b 04		      ADDA	#ACC2	; Leave the two low bits alone and increment the next 3 bits
    867  fa5f		       81 1c		      CMPA	#7*ACC2	; See if these bits have reached a value of 7
    868  fa61		       25 02		      BLO	NOT7	; If they have then
    869  fa63		       84 03		      ANDA	#ACC0+ACC1	;  start them over again at zero
    870  fa65		       84 fd	   NOT7       ANDA	#$FF-ACC1	; If the mode is time or date then set it to C or F
    871  fa67		       97 d5		      STAA	DISP_SELECT	; Return the selection bits
    872  fa69		       20 e3		      BRA	DISPLAY_MODE	; Repeat the loop with the new select bits
    873  fa6b
    874  fa6b							; Increment the switch 2 selection bits
    875  fa6b		       fa 6b	   INC_SW2    EQU	*	; Increment the zone selection bits
    876  fa6b		       d6 d6		      LDAB	ZONE_SELECT	; Get the current value of these bits
    877  fa6d		       5c		      INCB		; Increment to the next value
    878  fa6e		       c1 02		      CMPB	#2	; See if we have incremented past the last zone
    879  fa70		       23 01		      BLS	IS_LESS	; If we have then
    880  fa72		       5f		      CLRB		;  start over at zone 1
    881  fa73		       d7 d6	   IS_LESS    STAB	ZONE_SELECT	; Save the new value
    882  fa75		       20 d7		      BRA	DISPLAY_MODE	; Repeat the loop with the new select bits
    883  fa77
    884  fa77							; Increment the switch 1 selection bits
    885  fa77		       fa 77	   INC_SW1    EQU	*	; Increment the data type selection bits
    886  fa77		       d6 d5		      LDAB	DISP_SELECT	; Get the current value of these bits
    887  fa79		       5c	   SKIP_MODE  INCB		; Increment to the next value
    888  fa7a		       c5 03		      BITB	#ACC0+ACC1	; See if they have been incremented to zero
    889  fa7c		       27 16		      BEQ	TO_C	; If they have then go cancel out the carry into the upper bits
    890  fa7e		       c5 02		      BITB	#ACC1	; If not zero then are they 01 (Fahrenheit)
    891  fa80		       27 14		      BEQ	TO_F	; If so then just save the new value
    892  fa82		       c5 fc		      BITB	#$FF-ACC0-ACC1	; See if we are reading current value
    893  fa84		       27 10		      BEQ	TO_F	; If we are then this is legal for both date and time
    894  fa86		       c5 01		      BITB	#ACC0	; If not current then see if we are set to date
    895  fa88		       26 ef		      BNE	SKIP_MODE	; If so then the combination is illegal, go to the next
    896  fa8a		       c1 0e		      CMPB	#3*ACC2+2	; For time the only illegal combinations are today's
    897  fa8c		       27 eb		      BEQ	SKIP_MODE	;  mean and yesterday's mean
    898  fa8e		       c1 1a		      CMPB	#6*ACC2+2
    899  fa90		       27 e7		      BEQ	SKIP_MODE
    900  fa92		       20 02		      BRA	TO_F	; Otherwise save this value as is
    901  fa94
    902  fa94		       c0 04	   TO_C       SUBB	#4	; Cancel the carry from the low bits
    903  fa96		       d7 d5	   TO_F       STAB	DISP_SELECT	; Save the new value of the bits
    904  fa98		       20 b4		      BRA	DISPLAY_MODE	; Repeat the loop with the new select bits
    905  fa9a
    906  fa9a							;; PAGE 23 DISPLAY MODE ROUTINES
    907  fa9a
    908  fa9a							; Alternate display routine
    909  fa9a		       fa 9a	   ALT_MODE   EQU	*	; This is a display mode in which two or more pieces
    910  fa9a							;  of information can be displayed in sequence at intervals of a few
    911  fa9a							;  seconds. The mode is initially entered by pressing both S1 and S2
    912  fa9a							;  simultaneously. While in this mode the action of the three switches
    913  fa9a							;  is modified. S1 is now used to step more quickly through the
    914  fa9a							;  display sequence, or to hold the display on a particular value by
    915  fa9a							;  holding the switch in.  S2 is used to select a different zone to
    916  fa9a							;  be displayed while on either degrees C or degrees F. S3 is used
    917  fa9a							;  to exit from this mode and return to normal display mode.
    918  fa9a		       dc d5		      LDD	DISP_SELECT	; Display the currently selected item
    919  fa9c		       bd fc 12 	      JSR	BACKGROUND	;  and read the keyboard
    920  fa9f		       44		      LSRA		; See if switch 1 was just pressed
    921  faa0		       25 14		      BCS	ADVANCE_ALT	; If it was then advance to the next display item
    922  faa2		       44		      LSRA		; See if switch 2 was just pressed
    923  faa3		       25 2c		      BCS	ALT_ZONE	; If it was then advance to the next zone
    924  faa5		       44		      LSRA		; See if switch 3 was just pressed
    925  faa6		       25 a6		      BCS	DISPLAY_MODE	; If it was then exit from this mode
    926  faa8		       c5 01		      BITB	#ACC0	; If nothing just pressed then is switch 1 being held in
    927  faaa		       26 ee		      BNE	ALT_MODE	; If it is then hold the display on this item
    928  faac		       96 92	   ADVANCE_YET LDAA	TWENTIETHS	; See if it is time to advance the item
    929  faae		       81 31		      CMPA	#49
    930  fab0		       27 04		      BEQ	ADVANCE_ALT
    931  fab2		       81 6d		      CMPA	#109
    932  fab4		       26 e4		      BNE	ALT_MODE
    933  fab4		       fa b6	   ADVANCE_ALT EQU	*	; Three seconds have elapsed
    934  fab6		       96 d5		      LDAA	DISP_SELECT	; Get the corrent select bits
    935  fab8		       4c		      INCA		; Advance to the next item
    936  fab9		       84 03	   VALIDATE_ALT ANDA	#3	; Allow current values only
    937  fabb		       97 d5		      STAA	DISP_SELECT	; Put back the new select bits
    938  fabd		       d6 cb		      LDAB	ALT_SELECT	; See which items are selected for alternate display
    939  fabf		       58		      LSLB		; only the low 4 bits are used, one for each item
    940  fac0		       58		      LSLB
    941  fac1		       58		      LSLB
    942  fac2		       58		      LSLB
    943  fac3		       27 18		      BEQ	BAD_ALT	; If none of these bits is set then set some, so that we
    944  fac5							;  cannot accidentally get hung up here forever
    945  fac5		       58	   TEST_ALT   LSLB		; Shift the first select bit into the carry
    946  fac6		       4a		      DECA		; See if this is the right bit to test
    947  fac7		       2a fc		      BPL	TEST_ALT	; No, not yet - look at the next bit
    948  fac9		       24 eb		      BCC	ADVANCE_ALT	; If this item is not enabled then try the next one
    949  facb		       20 cd		      BRA	ALT_MODE	; Otherwise go ahead and display this item
    950  facd
    951  facd		       96 d5	   ENTER_ALT  LDAA	DISP_SELECT	; Enter this mode here to immediately start
    952  facf		       20 e8		      BRA	VALIDATE_ALT	;  displaying a valid mode
    953  fad1
    954  fad1							;; PAGE 24 DISPLAY MODE ROUTINES
    955  fad1
    956  fad1							; Select the next zone while in alternate display mode
    957  fad1		       96 d6	   ALT_ZONE   LDAA	ZONE_SELECT	; Select the next mode
    958  fad3		       4c		      INCA
    959  fad4		       81 03		      CMPA	#3	; See if we have passed zone 3
    960  fad6		       25 01		      BLO	NOT_THREE
    961  fad8		       4f		      CLRA		; If so then drop back to zone 1
    962  fad9		       97 d6	   NOT_THREE  STAA	ZONE_SELECT
    963  fadb		       20 cf		      BRA	ADVANCE_YET	; Now execute the remainder of the above routine
    964  fadd
    965  fadd		       7a 00 cb    BAD_ALT    DEC	ALT_SELECT	; If noe of the select bits were set then
    966  fae0							;  set them all
    967  fae0		       20 b8		      BRA	ALT_MODE	; Go ahead and display the current one
    968  fae2
    969  fae2							;; PAGE 25 DISPLAY MODE ROUTINES
    970  fae2
    971  fae2							; Set time and date routine
    972  fae2		       fa e2	   SET_MODE   EQU	*	; This is a display mode in which the time and date
    973  fae2							;  settings can be adjusted.  The mode is initially entered by pressing
    974  fae2							;  both s1 and s3 simultaneiously. Whiel in this mode S1 selects the
    975  fae2							;  next setting to be adjusted, S2 increments its value and S3
    976  fae2							;  decrements it.  After the last setting has been displayed and
    977  fae2							;  possibly adjusted, pressing s1 one more time returns to normal
    978  fae2							;  display mode.
    979  fae2		       cc 07 0b 	      LDD	#$070B	; Special select value to display the year and suppress
    980  fae5							;  other indicator lights
    981  fae5		       bd fc 12 	      JSR	BACKGROUND	; Display the current year setpoint and read the keyboard
    982  fae8		       44		      LSRA		; See if switch 1 was pressed
    983  fae9		       25 10		      BCS	SET_MONTH	; If it was then leave the year and on to the month
    984  faeb		       44		      LSRA		; See if switch 2 was pressed
    985  faec		       25 08		      BCS	INC_YEAR	; If it was then increment the year
    986  faee		       44		      LSRA		; See if switch 3 was pressed
    987  faef		       24 f1		      BCC	SET_MODE	; If none pressed, stay in this mode
