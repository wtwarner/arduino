    624  f98a							;; PAGE 16
    625  f98a
    626  f98a							;; Functions performed at midnight every day
    627  f98a
    628  f98a							; The following operations all have to do with updating the day,
    629  f98a							; month and year counters.  The day counter has a range of one to
    630  f98a							; 28, 29, 30 or 31, depending on the month, but is stored as twice
    631  f98a							; this value so that the least significant bit can be used as a flag
    632  f98a							; to indicate that a change from daylight saving time to standard
    633  f98a							; time has been made that day. The month has a value from 1 to 12
    634  f98a							; (January to December) and the year has a value between 0 (1984)
    635  f98a							; and 255 (2239).  All corrections for leap years are made properly
    636  f98a							; over this entire time span.
    637  f98a
    638  f98a		       f9 8a	   MIDNIGHT   EQU	*
    639  f98a		       8d 43		      BSR	DAYS_IN_MONTH	; Before incrementing the day we must see how many
    640  f98c							;  days there are in this month.
    641  f98c							; This value will be returned in register B
    642  f98c		       96 c5		      LDAA	DAY	; Now see what day of the month this is
    643  f98e		       44		      LSRA		; Shift out the daylight saving flag
    644  f98f		       11		      CBA		; See if we just ended the last day of a month
    645  f990		       25 14		      BLO	INC_DAY	; If not then just increment the day normally
    646  f992		       96 c8		      LDAA	MONTH	; If the month has just ended then increment the month
    647  f994		       81 0c		      CMPA	#12	; When the month ends there is also the possibility that
    648  f996		       25 0a		      BLO	INC_MONTH	;  the year has just ended
    649  f998		       7c 00 9b 	      INC	YEAR	; Execute this instruction once each year at midnight on
    650  f99b							;  December 31
    651  f99b
    652  f99b							;		     BEQ     *
    653  f99b							; Wouldn't it be fun to actually put the above instruction into the
    654  f99b							; program? I can just see it now......
    655  f99b							; It is new years eve in the year 2239, and precisely at midnight,
    656  f99b							; all around the world, everyone's HP clock thermometer suddenly
    657  f99b							; goes dead! Since every copy of this listing has long since been
    658  f99b							; lost, it will remain a mystery forever how this couild have happened.
    659  f99b							;
    660  f99b							; But seriously, what do we do when the last counter finally runs out?
    661  f99b							; Do we simply set it become 1984 all over again? This would allow the
    662  f99b							; corrections for leap year to be done properly for another 60 years
    663  f99b							; until the year 2300. But what about the corrections for daylight
    664  f99b							; saving time? The best soluition is to find a year between 1984 and
    665  f99b							; 2239 which is the same as 2240 with respect to leap years and
    666  f99b							; days of the week. As it happens, there are many years which meet
    667  f99b							; these requirements, the earliest being 1992. Of course, the year
    668  f99b							; will read incorrectly and it will still fail in the year 2300, but
    669  f99b							; then you can't have everything.
    670  f99b		       26 04		      BNE	NOT_ROLLOVER	; In any year except 2240, skip the next two instructions
    671  f99d		       86 08		      LDAA	#1992-1984	; Reset the year to 1992
    672  f99f		       97 9b		      STAA	YEAR
    673  f9a1		       4f	   NOT_ROLLOVER CLRA		; Reset the month to January
    674  f9a2		       4c	   INC_MONTH  INCA		; Increment the month value
    675  f9a3		       97 c8		      STAA	MONTH	; Save the incremented value
    676  f9a5		       4f		      CLRA		; Start the day counter over at day 1
    677  f9a6		       4c	   INC_DAY    INCA		; Increment the day value
    678  f9a7		       48		      LSLA		; Save it doubled form to leave room for the DST flag
    679  f9a8		       97 c5		      STAA	DAY	; Save the incremented value
    680  f9aa
    681  f9aa							;; PAGE 17  CLOCK TIMER INTERRUPT SERVICING
    682  f9aa
    683  f9aa							; The last function to be performed by the clock interrupt is
    684  f9aa							; the daily calculation of the average temperatures for that day and
    685  f9aa							; the saving of those values as the previous day's averages, followed
    686  f9aa							; by the re-initialization of today's averages and the updating of
    687  f9aa							; all of the minimum and maximum values
    688  f9aa
    689  f9aa		       ce 00 cc 	      LDX	#TODAY_MEAN1	; Point to the sum of the values for zone 1
    690  f9ad		       8d 48		      BSR	AVERAGE	; Convert this to an average value
    691  f9af		       dd c3		      STD	LAST_MEAN1	; Save this as yesterday's average
    692  f9b1		       ce 00 cf 	      LDX	#TODAY_MEAN2	; Do the same for the other two zones
    693  f9b4		       8d 41		      BSR	AVERAGE
    694  f9b6		       dd c6		      STD	LAST_MEAN2
    695  f9b8		       ce 00 d2 	      LDX	#TODAY_MEAN3
    696  f9bb		       8d 3a		      BSR	AVERAGE
    697  f9bd		       dd c9		      STD	LAST_MEAN3
    698  f9bf		       ce 00 12 	      LDX	#LAST_MIN1-TODAY_MIN1	; Now set yesterday's min and max values
    699  f9c2							;  to today's - use X as a byte counter and also a pointer
    700  f9c2		       a6 9e	   SET_LAST   LDAA	TODAY_MIN1-1,X	; Get one byte of today's data
    701  f9c4		       a7 b0		      STAA	LAST_MIN1-1,X	; Copy it into the corresponding byte of
    702  f9c6		       09		      DEX		;  yesterday's data and decrement the pointer/counter
    703  f9c7		       26 f9		      BNE	SET_LAST	; Repeat until all bytes have been copied
    704  f9c9		       7f 00 98 	      CLR	TIME_OF_DAY	; Reset the current time of day to midnight
    705  f9cc		       8d 4f		      BSR	INIT_MINMAX	; Initialize the minimu, maximum and average values
    706  f9ce		       3b	   IRQ_EXIT   RTI
    707  f9cf
    708  f9cf							;; PAGE 18 CLOCK TIMER INTERRUPT SERVICING
    709  f9cf
    710  f9cf							; Subroutine to find out how many days there are in a month
    711  f9cf		       f9 cf	   DAYS_IN_MONTH EQU	*
    712  f9cf		       d6 c8		      LDAB	MONTH	; See which month this is
    713  f9d1		       ce f9 ea 	      LDX	#MONTH_TABLE-1	; Point to a lookup table of days in a month
    714  f9d4		       3a		      ABX		; Index into the lookup table
    715  f9d5		       e6 00		      LDAB	0,X	; Load the value from the table
    716  f9d7		       c1 1c		      CMPB	#28	; See if this is February
    717  f9d9		       26 0f		      BNE	RETURN_DAYS	; If it is not then this is the correct number of days
    718  f9db		       96 9b		      LDAA	YEAR	; If it is then we must also see if this is a leap year
    719  f9dd		       85 03		      BITA	#ACC0+ACC1	; By looking at just the last two bits in the year we
    720  f9df		       26 09		      BNE	RETURN_DAYS	;  know whether or not it is divisible by four
    721  f9e1		       81 74		      CMPA	#2100-1984	; If it is then we must also test for two such years
    722  f9e3		       27 05		      BEQ	RETURN_DAYS	;  which will not be leap years - 2100 and 2200
    723  f9e5		       81 d8		      CMPA	#2200-1984	; Oddly enough, the year 2000 is a leap year
    724  f9e7		       27 01		      BEQ	RETURN_DAYS	; After eliminating all non leap years over this time
    725  f9e9		       5c		      INCB		;  span, this leaves only leap years, for which February
    726  f9ea							;  has 29 days
    727  f9ea		       39	   RETURN_DAYS RTS		; Return with the number of days in the current month
    728  f9eb							;  in register B
    729  f9eb
    730  f9eb		       f9 eb	   MONTH_TABLE EQU	*	; Lookup table of days in the month
    731  f9eb		       1f		      DC	31	; January
    732  f9ec		       1c		      DC	28	; February (may be 29)
    733  f9ed		       1f		      DC	31	; March
    734  f9ee		       1e		      DC	30	; April
    735  f9ef		       1f		      DC	31	; May
    736  f9f0		       1e		      DC	30	; June
    737  f9f1		       1f		      DC	31	; July
    738  f9f2		       1f		      DC	31	; August
    739  f9f3		       1e		      DC	30	; September
    740  f9f4		       1f		      DC	31	; October
    741  f9f5		       1e		      DC	30	; November
    742  f9f6		       1f		      DC	31	; December
    743  f9f7
    744  f9f7							;; PAGE 19 - CLOCK TIMER INTERRUPT SERVICING
    745  f9f7
    746  f9f7							; Subroutine to calculate the average value from the sum of the
    747  f9f7							; values and the number of values summed.
    748  f9f7		       f9 f7	   AVERAGE    EQU	*
    749  f9f7		       86 11		      LDAA	#17	; Go through the divide loop 17 times but only save 16 bits
    750  f9f9							;  of quotient
    751  f9f9		       36		      PSHA		; Push the counter byte onto the stack
    752  f9fa		       a6 02		      LDAA	2,X	; X points to the sum, so 2,x is the third byte of the sum
    753  f9fc		       36		      PSHA		; Use another stack location for this byte
    754  f9fd		       ec 00		      LDD	0,X	; Now load the first two bytes of the sum
    755  f9ff		       30		      TSX		; Make X now point to the two bytes which were placed on the stack
    756  fa00		       0c		      CLC		; Clear the carry to prevent A 1 from getting shifted in below
    757  fa01		       69 00	   AVG_DIVIDE ROL	0,X	; Shift the quotient and remainder left one bit
    758  fa03		       59		      ROLB		; The lowest of these three bytes is on the stack, then other
    759  fa04		       49		      ROLA		;  two in B and A
    760  fa05		       25 04		      BCS	SUBTRACT	; If a non-zero bit of the remainder shifts out the top
    761  fa07							;  then force a subtraction
    762  fa07		       91 9e		      CMPA	MEAN_COUNT	; Otherwise decide whether or not to subtract based
    763  fa09		       25 03		      BLO	NO_SUBTRACT	;  on whther the remainder is greater or less than
    764  fa0b							;  the number being divided by, the number of summed values
    765  fa0b		       90 9e	   SUBTRACT   SUBA	MEAN_COUNT	; Every time the remainder is large enough,
    766  fa0d		       0c		      CLC		;  subtract the divisor and shift in a zero for the quotient
    767  fa0d		       fa 0e	   NO_SUBTRACT EQU	*	; Every time it is too small, shift in a one
    768  fa0e		       6a 01		      DEC	1,X	; See if 17 passes have been made through the above loop
    769  fa10		       26 ef		      BNE	AVG_DIVIDE	; Repeat until done
    770  fa12							; After 17 passes, the 16 bit quotient is in B and the top byte of
    771  fa12							; the stack, in complemented form, and the seventeenth bit of the
    772  fa12							; quotient, also complemented, is in the carry flag
    773  fa12		       17		      TBA		; Move the first byte of quotient to register A
    774  fa13		       33		      PULB		; Move the second byte to B
    775  fa14		       31		      INS		; Discard the counter from the stack
    776  fa15		       25 03		      BCS	NO_CARRY	; Use the next bit of the quotient for rounding
    777  fa17		       83 00 01 	      SUBD	#1	; At this point all bits are still complemented so the
    778  fa1a							;  'branch if carry clear' and 'increment double' instructions
    779  fa1a							;  are instead 'branch if carry set' and 'decrement double'
    780  fa1a		       43	   NO_CARRY   COMA		; Finally convert the rounded qoutient from complemented to
    781  fa1b		       53		      COMB		;  true form and return
    782  fa1c		       39		      RTS
    783  fa1d
    784  fa1d							;; PAGE 20 CLOCK TIMER INTERRUPT SERVICING
    785  fa1d
    786  fa1d							; Subroutine to initialize today's minimum, maximum, and mean values
    787  fa1d
    788  fa1d		       fa 1d	   INIT_MINMAX EQU	*
    789  fa1d		       dc 8d		      LDD	CONV_BUF	; Take the current values of the zones
    790  fa1f		       dd cd		      STD	TODAY_MEAN1+1	; Initialize the sum, the minimum, and the maximum
    791  fa21		       dd 9f		      STD	TODAY_MIN1	;  to this value
    792  fa23		       dd a8		      STD	TODAY_MAX1
    793  fa25		       dc 90		      LDD	CONV_BUF+3
    794  fa27		       dd d0		      STD	TODAY_MEAN2+1
    795  fa29		       dd a2		      STD	TODAY_MIN2
    796  fa2b		       dd ab		      STD	TODAY_MAX2
    797  fa2d		       dc 93		      LDD	CONV_BUF+6
    798  fa2f		       dd d3		      STD	TODAY_MEAN3+1
    799  fa31		       dd a5		      STD	TODAY_MIN3
    800  fa33		       dd ae		      STD	TODAY_MAX3
    801  fa35		       96 98		      LDAA	TIME_OF_DAY	; Initialize the time of the min and max of each zone
    802  fa37							;  to the current time
    803  fa37		       97 a1		      STAA	TODAY_MIN1+2
    804  fa39		       97 aa		      STAA	TODAY_MAX1+2
    805  fa3b		       97 a4		      STAA	TODAY_MIN2+2
    806  fa3d		       97 ad		      STAA	TODAY_MAX2+2
    807  fa3f		       97 a7		      STAA	TODAY_MIN3+2
    808  fa41		       97 b0		      STAA	TODAY_MAX3+2
    809  fa43		       4f		      CLRA		; Initialize the highest byte of each sum to zero
    810  fa44		       97 cc		      STAA	TODAY_MEAN1
    811  fa46		       97 cf		      STAA	TODAY_MEAN2
    812  fa48		       97 d2		      STAA	TODAY_MEAN3
    813  fa4a		       4c		      INCA		; Set the number of values that have been summed so far this
    814  fa4b		       97 9e		      STAA	MEAN_COUNT	;  to one
    815  fa4d		       39		      RTS
